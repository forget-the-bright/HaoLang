// ============================================================
//  json.JSON —— 静态入口（对标 Fastjson2 JSON）
// ============================================================
package json;

import collections.*;
import lang;
import os;
import reflect;

// 可增长 JSON 缓冲：内部 lang.StringBuilder（v0.76；禁碎片树拼接）
public class JsonBuf {
    var sb: lang.StringBuilder;

    constructor() {
        this.sb = lang.StringBuilder.withCapacity(256);
    }

    static func withCapacity(capacity: Int): JsonBuf {
        val b = new JsonBuf();
        b.sb.ensureCapacity(capacity);
        return b;
    }

    func append(s: String) {
        this.sb.append(s);
    }

    func append(c: Char) {
        this.sb.append(c);
    }

    func appendLong(n: Long) {
        this.sb.append(n);
    }

    func appendBool(b: Bool) {
        this.sb.append(b);
    }

    func appendNull() {
        this.sb.appendNull();
    }

    func finish(): String {
        return this.sb.toString();
    }

    func builder(): lang.StringBuilder {
        return this.sb;
    }
}

// 对标 Fastjson ObjectWriterField / .NET JsonPropertyInfo：每字段一次元数据
class JsonFieldInfo {
    var quotedKey: String = "\"\"";
    var kind: Int = 0; // 1=String 2=Bool/Number 3=Object
    var index: Int = 0;
}

// 对标 Fastjson ObjectWriter / Jackson BeanDescription：按类缓存
class JsonBeanInfo {
    var fields: ArrayList<JsonFieldInfo>;

    constructor() {
        this.fields = new ArrayList<JsonFieldInfo>();
    }
}

class JSON {
    // Feature 位标志（toJSONString 可选）
    static val PrettyFormat: Int = 1;
    static val WriteMapNullValue: Int = 2;

    // Class 名 → BeanInfo（进程内缓存；字段 quotedKey 只编一次）
    static var beanCache: HashMap<String, JsonBeanInfo>? = null;

    static func beanCacheMap(): HashMap<String, JsonBeanInfo> {
        if (JSON.beanCache == null) {
            JSON.beanCache = new HashMap<String, JsonBeanInfo>();
        }
        return JSON.beanCache!!;
    }

    static func beanInfoOf(t: reflect.Class): JsonBeanInfo {
        val key = t.getName();
        val cache = JSON.beanCacheMap();
        val hit = cache.get(key);
        if (hit != null) { return hit!!; }
        val info = new JsonBeanInfo();
        var i = 0;
        val fc = t.getFieldCount();
        while (i < fc) {
            val name = t.getFieldName(i);
            val ft = t.getFieldType(i);
            val idx = i;
            i += 1;
            if (t.fieldIsStatic(idx)) { continue; }
            if (String.valueOf(name).startsWith("_")) { continue; }
            val fi = new JsonFieldInfo();
            fi.index = idx;
            fi.quotedKey = JSON.quote(name);
            if (JSON.fieldIsString(ft)) { fi.kind = 1; }
            else if (JSON.fieldIsBool(ft) || JSON.fieldIsNumber(ft)) { fi.kind = 2; }
            else { fi.kind = 3; }
            info.fields.add(fi);
        }
        cache.put(key, info);
        return info;
    }

    static func parse(text: String): Object {
        val p = new JsonParser(text);
        val v = p.parseValue();
        p.skipWs();
        if (p.i < p.s.length) {
            throw new JSONException("trailing data at " + Integer.toStr(p.i));
        }
        return v;
    }

    static func parseObject(text: String): JSONObject {
        val v = JSON.parse(text);
        if (v is JSONObject) { return v as JSONObject; }
        throw new JSONException("not a JSON object");
    }

    static func parseArray(text: String): JSONArray {
        val v = JSON.parse(text);
        if (v is JSONArray) { return v as JSONArray; }
        throw new JSONException("not a JSON array");
    }

    static func isValid(text: String): Bool {
        try {
            JSON.parse(text);
            return true;
        } catch (e: JSONException) {
            return false;
        }
    }

    static func toJSONString(value: Object): String {
        return JSON.stringify(value, 0, 0);
    }

    static func toJSONStringFeat(value: Object, features: Int): String {
        return JSON.stringify(value, features, 0);
    }

    // 具体 Map 快路径（entrySet for-in；避免 Object 反射）
    static func toJSONString(m: HashMap<String, Object>): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyHashMap(m, 0, 0, stack, 0);
    }

    static func toJSONString(m: LinkedHashMap<String, Object>): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyLinkedHashMap(m, 0, 0, stack, 0);
    }

    static func toJSONString(m: ConcurrentHashMap<String, Object>): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyConcurrentHashMap(m, 0, 0, stack, 0);
    }

    static func toJSONString(m: TreeMap<String, Object>): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyTreeMap(m, 0, 0, stack, 0);
    }

    static func toJSONString(obj: JSONObject): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyObj(obj, 0, 0, stack, 0);
    }

    static func toJSONString(arr: JSONArray): String {
        var stack: [Long] = new [Long]{};
        return JSON.stringifyArr(arr, 0, 0, stack, 0);
    }

    static func parseObjectFromFile(path: String): JSONObject {
        val t = os.readFile(path);
        if (t == null) {
            throw new JSONException("cannot read file: " + path);
        }
        return JSON.parseObject(t!!);
    }

    static func writeJSONString(path: String, value: Object): Bool {
        return os.writeFile(path, JSON.toJSONString(value));
    }

    // 有限 Bean：按反射字段名写入（字段值均以字符串形式 setField）
    static func parseInto(text: String, bean: Object): Object {
        val obj = JSON.parseObject(text);
        val t = reflect.typeOf(bean);
        var i = 0;
        while (i < t.getFieldCount()) {
            val name = t.getFieldName(i);
            if (obj.containsKey(name)) {
                t.setField(bean, name, obj.getString(name));
            }
            i += 1;
        }
        return bean;
    }

    static func valueToString(v: Object): String {
        if (v is JSONNull) { return "null"; }
        if (v is lang.String) { return (v as lang.String).toString(); }
        if (v is Integer) { return (v as Integer).toString(); }
        if (v is lang.Long) { return (v as lang.Long).toString(); }
        if (v is lang.Double) { return (v as lang.Double).toString(); }
        if (v is Boolean) { return (v as Boolean).toString(); }
        if (v is JSONObject) { return (v as JSONObject).toJSONString(); }
        if (v is JSONArray) { return (v as JSONArray).toJSONString(); }
        return v.toString();
    }

    static func valueToInt(v: Object?): Int {
        if (v == null) { return 0; }
        val x = v!!;
        if (x is Integer) { return (x as Integer).intValue(); }
        if (x is lang.Long) {
            val p = Integer.parse(Long.toStr((x as lang.Long).longValue()));
            if (p == null) { return 0; }
            return p!!;
        }
        if (x is lang.Double) {
            val p = Integer.parse(Double.toStr((x as lang.Double).doubleValue()));
            if (p == null) { return 0; }
            return p!!;
        }
        if (x is lang.String) {
            val p = Integer.parse((x as lang.String).toString());
            if (p == null) { return 0; }
            return p!!;
        }
        return 0;
    }

    static func valueToLong(v: Object?): Long {
        if (v == null) { return 0; }
        val x = v!!;
        if (x is lang.Long) { return (x as lang.Long).longValue(); }
        if (x is Integer) {
            val p = Long.parse(Integer.toStr((x as Integer).intValue()));
            if (p == null) { return 0; }
            return p!!;
        }
        if (x is lang.Double) {
            val p = Long.parse(Double.toStr((x as lang.Double).doubleValue()));
            if (p == null) { return 0; }
            return p!!;
        }
        if (x is lang.String) {
            val p = Long.parse((x as lang.String).toString());
            if (p == null) { return 0; }
            return p!!;
        }
        return 0;
    }

    static func valueToDouble(v: Object?): Double {
        if (v == null) { return 0.0; }
        val x = v!!;
        if (x is lang.Double) { return (x as lang.Double).doubleValue(); }
        if (x is Integer) {
            val p = Double.parse(Integer.toStr((x as Integer).intValue()));
            if (p == null) { return 0.0; }
            return p!!;
        }
        if (x is lang.Long) {
            val p = Double.parse(Long.toStr((x as lang.Long).longValue()));
            if (p == null) { return 0.0; }
            return p!!;
        }
        if (x is lang.String) {
            val p = Double.parse((x as lang.String).toString());
            if (p == null) { return 0.0; }
            return p!!;
        }
        return 0.0;
    }

    static func valueToBool(v: Object?): Bool {
        if (v == null) { return false; }
        val x = v!!;
        if (x is Boolean) { return (x as Boolean).booleanValue(); }
        if (x is lang.String) {
            val p = Boolean.parse((x as lang.String).toString());
            if (p == null) { return false; }
            return p!!;
        }
        return false;
    }

    static val MAX_DEPTH: Int = 32;

    static func stringify(value: Object, features: Int, indent: Int): String {
        var stack: [Long] = new [Long]{};
        val buf = JsonBuf.withCapacity(512);
        JSON.stringifyAtInto(buf, value, features, indent, stack, 0);
        return buf.finish();
    }

    static func stackHas(stack: [Long], p: Long): Bool {
        var i = 0;
        while (i < stack.length) {
            if (stack[i] == p) { return true; }
            i += 1;
        }
        return false;
    }

    static func stackPush(stack: [Long], p: Long): [Long] {
        val n = new [Long](stack.length + 1);
        if (stack.length > 0) {
            val nl: Long = stack.length;
            _arraycopy(n, 0, stack, 0, nl);
        }
        n[stack.length] = p;
        return n;
    }

    // 优先 $jsonWrite（meta）；否则通用 stringifyAt 片段再 append
    static func stringifyAtInto(buf: JsonBuf, value: Object, features: Int, indent: Int, stack: [Long], depth: Int) {
        if (_jsonTryWrite(value, buf.builder(), features, indent, stack, depth) != 0) {
            return;
        }
        buf.append(JSON.stringifyAt(value, features, indent, stack, depth));
    }

    // Map 形态：entrySet()+get(K)（泛型 is/as Map 当前不可用，走反射）
    static func looksLikeMap(t: reflect.Class): Bool {
        return t.methodParamCount("entrySet") == 0 && t.methodParamCount("get") == 1;
    }

    // 是否 List 形态（size+get，且无 entrySet）
    static func looksLikeList(t: reflect.Class): Bool {
        return t.methodParamCount("size") == 0 && t.methodParamCount("get") == 1
            && t.methodParamCount("entrySet") != 0;
    }

    static func fieldIsString(ft: String): Bool {
        return ft == "String" || ft == "String?";
    }

    static func fieldIsBool(ft: String): Bool {
        return ft == "Bool";
    }

    static func fieldIsNumber(ft: String): Bool {
        return ft == "Int" || ft == "Long" || ft == "UInt" || ft == "ULong"
            || ft == "UIntPtr" || ft == "Short" || ft == "UShort"
            || ft == "Byte" || ft == "SByte" || ft == "Float" || ft == "Double"
            || ft == "Char";
    }

    static func stringifyAt(value: Object, features: Int, indent: Int, stack: [Long], depth: Int): String {
        if (depth > JSON.MAX_DEPTH) {
            throw new JSONException("JSON depth exceeded");
        }
        if (value is JSONNull) { return "null"; }
        if (value is Boolean) {
            if ((value as Boolean).booleanValue()) { return "true"; }
            return "false";
        }
        if (value is Integer) { return Integer.toStr((value as Integer).intValue()); }
        if (value is lang.Long) { return Long.toStr((value as lang.Long).longValue()); }
        if (value is lang.Double) { return Double.toStr((value as lang.Double).doubleValue()); }
        if (value is lang.String) {
            return JSON.quote((value as lang.String).toString());
        }
        if (value is JSONObject) {
            return JSON.stringifyObj(value as JSONObject, features, indent, stack, depth);
        }
        if (value is JSONArray) {
            return JSON.stringifyArr(value as JSONArray, features, indent, stack, depth);
        }
        val p = reflect.ptrOf(value);
        if (JSON.stackHas(stack, p)) { return "null"; }
        val t = reflect.typeOf(value);
        if (t.meta == null) {
            return JSON.quote(value.toString());
        }
        val next2 = JSON.stackPush(stack, p);
        if (value is Map) {
            return JSON.stringifyMapIface(value as Map<String, Object>, features, indent, next2, depth + 1);
        }
        if (value is List) {
            return JSON.stringifyListIface(value as List<Object>, features, indent, next2, depth + 1);
        }
        // 反射 duck typing 兜底（非 Map/List 接口形态）
        if (JSON.looksLikeMap(t)) {
            return JSON.stringifyMapReflect(value, t, features, indent, next2, depth + 1);
        }
        if (JSON.looksLikeList(t)) {
            return JSON.stringifyList(value, t, features, indent, next2, depth + 1);
        }
        return JSON.stringifyBean(value, t, features, indent, next2, depth + 1);
    }

    // 反射遍历 keySet（优先）或 entrySet；禁 hao_array_*
    static func stringifyMapReflect(value: Object, t: reflect.Class, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var emptyArgs: [Long] = new [Long]{};
        // 优先 keySet：next 为 String 时可 invokeStr，避开 MapEntry 嵌套泛型
        if (t.methodParamCount("keySet") == 0) {
            val ksObj = t.invokeObj(value, "keySet", emptyArgs);
            if (ksObj != null) {
                val ks = ksObj!!;
                val kst = reflect.typeOf(ks);
                val iterObj = kst.invokeObj(ks, "iterator", emptyArgs);
                if (iterObj != null) {
                    val iter = iterObj!!;
                    val it = reflect.typeOf(iter);
                    var r = "{";
                    var first = true;
                    while (it.invokeBool(iter, "hasNext", emptyArgs)) {
                        val kStr = it.invokeStr(iter, "next", emptyArgs);
                        if (kStr == null) { continue; }
                        var gargs: [Long] = new [Long]{ reflect.ptrOfStr(kStr!!) };
                        val child = t.invokeObj(value, "get", gargs);
                        if (!first) { r = r + ","; }
                        first = false;
                        if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
                        r = r + JSON.quote(kStr!!) + ":";
                        if (pretty) { r = r + " "; }
                        if (child == null) {
                            r = r + "null";
                        } else {
                            r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
                        }
                    }
                    if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
                    return r + "}";
                }
            }
        }
        val esObj = t.invokeObj(value, "entrySet", emptyArgs);
        if (esObj == null) { return "{}"; }
        val es = esObj!!;
        val est = reflect.typeOf(es);
        val iterObj2 = est.invokeObj(es, "iterator", emptyArgs);
        if (iterObj2 == null) { return "{}"; }
        val iter2 = iterObj2!!;
        val it2 = reflect.typeOf(iter2);
        var r2 = "{";
        var first2 = true;
        while (it2.invokeBool(iter2, "hasNext", emptyArgs)) {
            val eObj = it2.invokeObj(iter2, "next", emptyArgs);
            if (eObj == null) { continue; }
            val e = eObj!!;
            val et = reflect.typeOf(e);
            val child = et.invokeObj(e, "getValue", emptyArgs);
            var kStr = et.invokeStr(e, "getKey", emptyArgs);
            if (kStr == null) {
                // 非 String 键：尽力 toString（不走 raw String 的 Object 伪装）
                val kObj = et.invokeObj(e, "getKey", emptyArgs);
                if (kObj == null) { kStr = "null"; }
                else if (kObj!! is Integer) {
                    kStr = Integer.toStr((kObj!! as Integer).intValue());
                } else if (kObj!! is lang.Long) {
                    kStr = Long.toStr((kObj!! as lang.Long).longValue());
                } else if (kObj!! is Boolean) {
                    if ((kObj!! as Boolean).booleanValue()) { kStr = "true"; }
                    else { kStr = "false"; }
                } else {
                    kStr = "?";
                }
            }
            if (!first2) { r2 = r2 + ","; }
            first2 = false;
            if (pretty) { r2 = r2 + "\n" + JSON.pad(indent + 1); }
            r2 = r2 + JSON.quote(kStr!!) + ":";
            if (pretty) { r2 = r2 + " "; }
            if (child == null) {
                r2 = r2 + "null";
            } else {
                r2 = r2 + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first2) { r2 = r2 + "\n" + JSON.pad(indent); }
        return r2 + "}";
    }

    // 具体类型快路径（keys 数组 for-in + get；entrySet 嵌套泛型 for-in 尚不稳）
    static func stringifyHashMap(m: HashMap<String, Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "{";
        var first = true;
        for (kStr in m.keys()) {
            val child = m.get(kStr);
            if (!first) { r = r + ","; }
            first = false;
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            r = r + JSON.quote(kStr) + ":";
            if (pretty) { r = r + " "; }
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
        return r + "}";
    }

    static func stringifyLinkedHashMap(m: LinkedHashMap<String, Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "{";
        var first = true;
        for (kStr in m.keys()) {
            val child = m.get(kStr);
            if (!first) { r = r + ","; }
            first = false;
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            r = r + JSON.quote(kStr) + ":";
            if (pretty) { r = r + " "; }
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
        return r + "}";
    }

    static func stringifyConcurrentHashMap(m: ConcurrentHashMap<String, Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "{";
        var first = true;
        for (kStr in m.keys()) {
            val child = m.get(kStr);
            if (!first) { r = r + ","; }
            first = false;
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            r = r + JSON.quote(kStr) + ":";
            if (pretty) { r = r + " "; }
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
        return r + "}";
    }

    static func stringifyTreeMap(m: TreeMap<String, Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "{";
        var first = true;
        for (kStr in m.keys()) {
            val child = m.get(kStr);
            if (!first) { r = r + ","; }
            first = false;
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            r = r + JSON.quote(kStr) + ":";
            if (pretty) { r = r + " "; }
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
        return r + "}";
    }

    static func stringifyMapIface(m: Map<String, Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "{";
        var first = true;
        for (ent in m.entrySet().toArray()) {
            val kStr = ent.getKey();
            val child = ent.getValue();
            if (!first) { r = r + ","; }
            first = false;
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            r = r + JSON.quote(kStr) + ":";
            if (pretty) { r = r + " "; }
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
        }
        if (pretty && !first) { r = r + "\n" + JSON.pad(indent); }
        return r + "}";
    }

    static func stringifyListIface(lst: List<Object>, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var r = "[";
        var i = 0;
        val sz = lst.size();
        while (i < sz) {
            if (i > 0) { r = r + ","; }
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            val child = lst.get(i);
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
            i += 1;
        }
        if (pretty && sz > 0) { r = r + "\n" + JSON.pad(indent); }
        return r + "]";
    }

    static func stringifyList(value: Object, t: reflect.Class, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        var emptyArgs: [Long] = new [Long]{};
        val sz = t.invoke(value, "size", emptyArgs);
        var r = "[";
        var i = 0;
        while (i < sz) {
            if (i > 0) { r = r + ","; }
            if (pretty) { r = r + "\n" + JSON.pad(indent + 1); }
            var gargs: [Long] = new [Long]{ i };
            val child = t.invokeObj(value, "get", gargs);
            if (child == null) {
                r = r + "null";
            } else {
                r = r + JSON.stringifyAt(child!!, features, indent + 1, stack, depth);
            }
            i += 1;
        }
        if (pretty && sz > 0) { r = r + "\n" + JSON.pad(indent); }
        return r + "]";
    }

    // 反射 Bean：写入 JsonBuf（冷回落；热路径走 $jsonWrite）
    static func stringifyBean(value: Object, t: reflect.Class, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val buf = new JsonBuf();
        JSON.stringifyBeanInto(buf, value, t, features, indent, stack, depth);
        return buf.finish();
    }

    static func stringifyBeanInto(buf: JsonBuf, value: Object, t: reflect.Class, features: Int, indent: Int, stack: [Long], depth: Int) {
        val pretty = (features & JSON.PrettyFormat) != 0;
        val info = JSON.beanInfoOf(t);
        buf.append("{");
        var first = true;
        var i = 0;
        val n = info.fields.size();
        while (i < n) {
            val f = info.fields.get(i);
            i += 1;
            if (!first) { buf.append(","); }
            first = false;
            if (pretty) {
                buf.append("\n");
                buf.append(JSON.pad(indent + 1));
            }
            buf.append(f.quotedKey);
            buf.append(":");
            if (pretty) { buf.append(" "); }
            if (f.kind == 1) {
                val s = t.getFieldAt(value, f.index);
                if (s == null) { buf.appendNull(); }
                else { JSON.quoteInto(buf, s!!); }
            } else if (f.kind == 2) {
                val s = t.getFieldAt(value, f.index);
                if (s == null) { buf.appendNull(); }
                else { buf.append(s!!); }
            } else {
                val child = t.getFieldObjectAt(value, f.index);
                if (child == null) { buf.appendNull(); }
                else { JSON.stringifyAtInto(buf, child!!, features, indent + 1, stack, depth); }
            }
        }
        if (pretty && !first) {
            buf.append("\n");
            buf.append(JSON.pad(indent));
        }
        buf.append("}");
    }

    static func stringifyObj(obj: JSONObject, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        val writeNull = (features & JSON.WriteMapNullValue) != 0;
        val keySnap = obj.keys();
        val nkeys = keySnap.length;
        val buf = new JsonBuf();
        buf.append("{");
        var first = true;
        var i = 0;
        while (i < nkeys) {
            val k = keySnap[i];
            val v = obj.get(k);
            i += 1;
            if (v == null) { continue; }
            if ((!writeNull) && (v!! is JSONNull)) { continue; }
            if (!first) { buf.append(","); }
            first = false;
            if (pretty) {
                buf.append("\n");
                buf.append(JSON.pad(indent + 1));
            }
            JSON.quoteInto(buf, k);
            buf.append(":");
            if (pretty) { buf.append(" "); }
            JSON.stringifyAtInto(buf, v!!, features, indent + 1, stack, depth + 1);
        }
        if (pretty && !first) {
            buf.append("\n");
            buf.append(JSON.pad(indent));
        }
        buf.append("}");
        return buf.finish();
    }

    static func stringifyArr(arr: JSONArray, features: Int, indent: Int, stack: [Long], depth: Int): String {
        val pretty = (features & JSON.PrettyFormat) != 0;
        val buf = new JsonBuf();
        buf.append("[");
        var i = 0;
        while (i < arr.size()) {
            if (i > 0) { buf.append(","); }
            if (pretty) {
                buf.append("\n");
                buf.append(JSON.pad(indent + 1));
            }
            JSON.stringifyAtInto(buf, arr.get(i), features, indent + 1, stack, depth + 1);
            i += 1;
        }
        if (pretty && arr.size() > 0) {
            buf.append("\n");
            buf.append(JSON.pad(indent));
        }
        buf.append("]");
        return buf.finish();
    }

    static func pad(n: Int): String {
        val buf = lang.StringBuilder.withCapacity(n * 2);
        var i = 0;
        while (i < n) {
            buf.append("  ");
            i += 1;
        }
        return buf.toString();
    }

    static func quoteInto(buf: JsonBuf, s: String) {
        JSON.quoteIntoSb(buf.builder(), s);
    }

    static func quoteIntoSb(sb: lang.StringBuilder, s: String) {
        // 一次 get_bytes 扫 UTF-8（禁每码点 s.length/s[i] 反复拷贝）
        sb.append("\"");
        val bytes = hao_str_get_bytes(s);
        var bi = 0;
        val n = bytes.length;
        while (bi < n) {
            val c = Character.utf8CpAt(bytes, bi);
            val next = Character.utf8NextByte(bytes, bi);
            if (c == 34) { sb.append("\\\""); }
            else if (c == 92) { sb.append("\\\\"); }
            else if (c == 10) { sb.append("\\n"); }
            else if (c == 13) { sb.append("\\r"); }
            else if (c == 9) { sb.append("\\t"); }
            else { sb.append(c); }
            if (next <= bi) { bi = bi + 1; }
            else { bi = next; }
        }
        sb.append("\"");
    }

    static func quote(s: String): String {
        val buf = JsonBuf.withCapacity(s.length + 8);
        JSON.quoteInto(buf, s);
        return buf.finish();
    }
}

extern func _jsonTryWrite(o: Object, sb: lang.StringBuilder, features: Int, indent: Int, stack: [Long], depth: Int): Int = "hao_json_try_write";

class JsonParser {
    var s: String;
    var i: Int;

    constructor(text: String) {
        this.s = text;
        this.i = 0;
    }

    func skipWs() {
        while (this.i < this.s.length) {
            val c = this.s[this.i];
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                this.i += 1;
            } else {
                return;
            }
        }
    }

    func peek(): Char {
        if (this.i >= this.s.length) { return 0; }
        return this.s[this.i];
    }

    func bump(): Char {
        val c = this.peek();
        this.i += 1;
        return c;
    }

    func expect(ch: Char) {
        this.skipWs();
        if (this.peek() != ch) {
            throw new JSONException("expected '" + ch + "' at " + Integer.toStr(this.i));
        }
        this.i += 1;
    }

    func parseValue(): Object {
        this.skipWs();
        val c = this.peek();
        if (c == 123) { return this.parseObject(); }
        if (c == 91) { return this.parseArray(); }
        if (c == 34) { return String.valueOf(this.parseString()); }
        if (c == 116) { return this.parseLiteral("true", Boolean.valueOf(true)); }
        if (c == 102) { return this.parseLiteral("false", Boolean.valueOf(false)); }
        if (c == 110) { return this.parseLiteral("null", JSONNull.INSTANCE); }
        if (c == 45 || (c >= 48 && c <= 57)) { return this.parseNumber(); }
        throw new JSONException("unexpected char at " + Integer.toStr(this.i));
    }

    func parseLiteral(lit: String, value: Object): Object {
        var k = 0;
        while (k < lit.length) {
            if (this.i >= this.s.length || this.s[this.i] != lit[k]) {
                throw new JSONException("invalid literal at " + Integer.toStr(this.i));
            }
            this.i += 1;
            k += 1;
        }
        return value;
    }

    func parseObject(): JSONObject {
        this.expect(123);
        val obj = new JSONObject();
        this.skipWs();
        if (this.peek() == 125) {
            this.i += 1;
            return obj;
        }
        while (true) {
            this.skipWs();
            if (this.peek() != 34) {
                throw new JSONException("expected string key at " + Integer.toStr(this.i));
            }
            val key = this.parseString();
            this.expect(58);
            val value = this.parseValue();
            obj.put(key, value);
            this.skipWs();
            val sep = this.peek();
            if (sep == 125) {
                this.i += 1;
                return obj;
            }
            if (sep != 44) {
                throw new JSONException("expected ',' or '}' at " + Integer.toStr(this.i));
            }
            this.i += 1;
        }
        return obj;
    }

    func parseArray(): JSONArray {
        this.expect(91);
        val arr = new JSONArray();
        this.skipWs();
        if (this.peek() == 93) {
            this.i += 1;
            return arr;
        }
        while (true) {
            arr.add(this.parseValue());
            this.skipWs();
            val sep = this.peek();
            if (sep == 93) {
                this.i += 1;
                return arr;
            }
            if (sep != 44) {
                throw new JSONException("expected ',' or ']' at " + Integer.toStr(this.i));
            }
            this.i += 1;
        }
        return arr;
    }

    func parseString(): String {
        if (this.bump() != 34) {
            throw new JSONException("expected string at " + Integer.toStr(this.i));
        }
        var r = "";
        while (this.i < this.s.length) {
            val c = this.bump();
            if (c == 34) { return r; }
            if (c == 92) {
                val e = this.bump();
                if (e == 34) { r = r + "\""; }
                else if (e == 92) { r = r + "\\"; }
                else if (e == 47) { r = r + "/"; }
                else if (e == 98) { val bs: Char = 8; r = r + bs; }
                else if (e == 102) { val ff: Char = 12; r = r + ff; }
                else if (e == 110) { r = r + "\n"; }
                else if (e == 114) { r = r + "\r"; }
                else if (e == 116) { r = r + "\t"; }
                else if (e == 117) {
                    // \uXXXX → 码点 Char 拼接（禁止 String+Int 十进制）
                    var code = 0;
                    var n = 0;
                    while (n < 4) {
                        val h = this.bump();
                        var d = 0;
                        if (h >= 48 && h <= 57) { d = h - 48; }
                        else if (h >= 65 && h <= 70) { d = h - 55; }
                        else if (h >= 97 && h <= 102) { d = h - 87; }
                        else { throw new JSONException("bad unicode escape"); }
                        code = code * 16 + d;
                        n += 1;
                    }
                    val uch: Char = code;
                    r = r + uch;
                } else {
                    throw new JSONException("bad escape");
                }
            } else {
                r = r + c;
            }
        }
        throw new JSONException("unterminated string");
    }

    func parseNumber(): Object {
        val start = this.i;
        if (this.peek() == 45) { this.i += 1; }
        if (this.peek() == 48) {
            this.i += 1;
        } else {
            if (this.peek() < 48 || this.peek() > 57) {
                throw new JSONException("invalid number");
            }
            while (this.peek() >= 48 && this.peek() <= 57) { this.i += 1; }
        }
        var isFloat = false;
        if (this.peek() == 46) {
            isFloat = true;
            this.i += 1;
            if (this.peek() < 48 || this.peek() > 57) {
                throw new JSONException("invalid number");
            }
            while (this.peek() >= 48 && this.peek() <= 57) { this.i += 1; }
        }
        val c = this.peek();
        if (c == 101 || c == 69) {
            isFloat = true;
            this.i += 1;
            val s = this.peek();
            if (s == 43 || s == 45) { this.i += 1; }
            if (this.peek() < 48 || this.peek() > 57) {
                throw new JSONException("invalid number");
            }
            while (this.peek() >= 48 && this.peek() <= 57) { this.i += 1; }
        }
        val raw = String.valueOf(this.s).substring(start, this.i);
        if (isFloat) {
            val d = Double.parse(raw);
            if (d == null) { throw new JSONException("bad double: " + raw); }
            return Double.valueOf(d!!);
        }
        val lv = Long.parse(raw);
        if (lv == null) { throw new JSONException("bad long: " + raw); }
        val n = lv!!;
        if (n >= 0 - 2147483647 - 1 && n <= 2147483647) {
            val ni: Int = n;
            return Integer.valueOf(ni);
        }
        return Long.valueOf(n);
    }
}

