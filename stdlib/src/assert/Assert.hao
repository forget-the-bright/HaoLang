// ============================================================
//  assert —— 断言（v0.22.0 补充，纯 .hao）
// ------------------------------------------------------------
//  失败时抛 exception.Exception（可被 try/catch）。
//
//  用法：
//      import assert;
//      assert.that(x > 0, "x 必须为正");
//      assert.eq(a, b, "应相等");
// ============================================================
package assert;

import exception;

func that(cond: Bool, msg: String) {
    if (!cond) {
        throw new exception.Exception(msg);
    }
}

func that(cond: Bool) {
    that(cond, "assertion failed");
}

func eq(a: Int, b: Int, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg + " (got " + a + ", want " + b + ")");
    }
}

func eq(a: Int, b: Int) {
    eq(a, b, "assert.eq failed");
}

func eq(a: Long, b: Long, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg + " (got " + a + ", want " + b + ")");
    }
}

func eq(a: Long, b: Long) {
    eq(a, b, "assert.eq failed");
}

func eq(a: Double, b: Double, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg + " (got " + a + ", want " + b + ")");
    }
}

func eq(a: Double, b: Double) {
    eq(a, b, "assert.eq failed");
}

func eq(a: String, b: String, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg + " (got \"" + a + "\", want \"" + b + "\")");
    }
}

func eq(a: String, b: String) {
    eq(a, b, "assert.eq failed");
}

func eq(a: Bool, b: Bool, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg);
    }
}

func eq(a: Bool, b: Bool) {
    eq(a, b, "assert.eq failed");
}

func eq(a: Float, b: Float, msg: String) {
    if (a != b) {
        throw new exception.Exception(msg + " (got " + a + ", want " + b + ")");
    }
}

func eq(a: Float, b: Float) {
    eq(a, b, "assert.eq failed");
}

func eq(a: Object, b: Object, msg: String) {
    if (!a.equals(b)) {
        throw new exception.Exception(msg);
    }
}

func eq(a: Object, b: Object) {
    eq(a, b, "assert.eq failed");
}

func notNull(x: Object?, msg: String) {
    if (x == null) {
        throw new exception.Exception(msg);
    }
}

func notNull(x: Object?) {
    notNull(x, "expected non-null");
}
