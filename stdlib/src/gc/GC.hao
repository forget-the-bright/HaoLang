package gc;

import exception;

// ============================================================
//  gc.GC —— 垃圾回收详情与手动回收
// ------------------------------------------------------------
//  职责：查询 GC 运行状态，并显式触发一次 major 收集。
//  能力（v0.70）：弱/软引用；语言 OOM 载荷；速率面板；miss 源码粘滞；全线程 VERIFY。
//  详文 docs/IR与GC契约.md。
// ============================================================

extern func gc_collect(): Unit = "gc_collect";
extern func hao_gc_ensure_oom_exc(): Unit = "hao_gc_ensure_oom_exc";
extern func hao_gc_test_force_oom_once(): Unit = "hao_gc_test_force_oom_once";
extern func hao_gc_live_bytes(): Long = "hao_gc_live_bytes";
extern func hao_gc_threshold(): Long = "hao_gc_threshold";
extern func hao_gc_allocated_since(): Long = "hao_gc_allocated_since";
extern func hao_gc_block_count(): Long = "hao_gc_block_count";
extern func hao_gc_collect_count(): Long = "hao_gc_collect_count";
extern func hao_gc_minor_count(): Long = "hao_gc_minor_count";
extern func hao_gc_major_count(): Long = "hao_gc_major_count";
extern func hao_gc_nursery_bytes(): Long = "hao_gc_nursery_bytes";
extern func hao_gc_registered_threads(): Long = "hao_gc_registered_threads";
extern func hao_gc_finalizer_runs(): Long = "hao_gc_finalizer_runs";
extern func hao_gc_finalizer_sets(): Long = "hao_gc_finalizer_sets";
extern func hao_gc_finalizer_exceptions(): Long = "hao_gc_finalizer_exceptions";
extern func hao_gc_stw_incomplete(): Long = "hao_gc_stw_incomplete";
extern func hao_gc_stw_grace_rescues(): Long = "hao_gc_stw_grace_rescues";
extern func hao_gc_stw_mark_all_fallbacks(): Long = "hao_gc_stw_mark_all_fallbacks";
extern func hao_gc_concurrent_mark_cycles(): Long = "hao_gc_concurrent_mark_cycles";
extern func hao_gc_concurrent_sweep_cycles(): Long = "hao_gc_concurrent_sweep_cycles";
extern func hao_gc_span_sweep_chunks(): Long = "hao_gc_span_sweep_chunks";
extern func hao_gc_freelist_hits(): Long = "hao_gc_freelist_hits";
extern func hao_gc_heap_bytes(): Long = "hao_gc_heap_bytes";
extern func hao_gc_set_oom_exception(exc: Object): Unit = "hao_gc_set_oom_exception";
extern func hao_gc_last_miss_file(): String = "hao_gc_last_miss_file";
extern func hao_gc_last_miss_line(): Long = "hao_gc_last_miss_line";
extern func hao_gc_last_miss_col(): Long = "hao_gc_last_miss_col";
extern func hao_gc_mark_assist_steps(): Long = "hao_gc_mark_assist_steps";
extern func hao_gc_mark_abort_cycles(): Long = "hao_gc_mark_abort_cycles";
extern func hao_gc_mark_worker_steps(): Long = "hao_gc_mark_worker_steps";
extern func hao_gc_remset_count(): Long = "hao_gc_remset_count";

// 与 hao_gc_stats 槽位序锁定：槽 0=vtable，下列字段从槽 1 起依次写入。
public class GcStats {
    var liveBytes: Long = 0;
    var heapBytes: Long = 0;
    var nurseryBytes: Long = 0;
    var threshold: Long = 0;
    var allocatedSinceGc: Long = 0;
    var blockCount: Long = 0;
    var collectCount: Long = 0;
    var minorCount: Long = 0;
    var majorCount: Long = 0;
    var finalizerRuns: Long = 0;
    var finalizerSets: Long = 0;
    var stwIncomplete: Long = 0;
    var stwMarkAllFallbacks: Long = 0;
    var concurrentMarkCycles: Long = 0;
    var markAssistSteps: Long = 0;
    var registeredThreads: Long = 0;
    var markAbortCycles: Long = 0; /* 终止失败 abort MARK（v0.53.3） */
    var markWorkerSteps: Long = 0; /* GC 私有 mark worker 推进量（v0.54） */
    var remsetCount: Long = 0; /* 分代 remset 条目数（v0.55.2；仅服务 minor） */
    var parkWatchdogTrips: Long = 0; /* park_wait 超时强行放行（v0.55.11） */
    /* v0.55.52：分相 incomplete/abort + 末次未齐快照（槽 21..31） */
    var stwIncompleteRoot: Long = 0;
    var stwIncompleteTerm: Long = 0;
    var markAbortRoot: Long = 0;
    var markAbortTerm: Long = 0;
    var markAbortParkWd: Long = 0;
    var lastStwPhase: Long = 0;          /* 0=无 1=root 2=term */
    var lastStwAttempt: Long = 0;
    var lastStwTargets: Long = 0;
    var lastStwParked: Long = 0;
    var lastStwMissing: Long = 0;
    var lastStwOsBlockMissing: Long = 0;
    /* v0.55.53：缺 park tid/龄 + finalizer 发现面（槽 32..38） */
    var lastMissTidCount: Long = 0;
    var lastMissTid0: Long = 0;
    var lastMissTid1: Long = 0;
    var lastMissMaxAgeMs: Long = -1; /* -1=无样本/从未 SP */
    var finalizerSkipAbort: Long = 0;  /* abort 跳过 sweep/drain 累计 */
    var finalizerLiveAtSweep: Long = 0; /* 上次成功 sweep 仍活且带 finalizer */
    var lastFinalizerDiag: Long = 0;   /* 0=无 1=live 主导 2=abort 主导 */
    var concurrentSweepCycles: Long = 0; /* 成功 concurrent sweep 轮次 */
    var spanSweepChunks: Long = 0; /* mspan 槽回收入队次数 */
    var freelistHits: Long = 0; /* mspan 空闲槽复用命中 */
    /* v0.69+：速率面板 + miss 源码粘滞（速率=进程起算均值） */
    var allocRateBps: Long = 0; /* 分配字节/秒（进程起算均值） */
    var freeRateBps: Long = 0; /* 回收字节/秒（进程起算均值） */
    var stwWaitMsTotal: Long = 0;
    var promoteCount: Long = 0;
    var promoteRatePerSec: Long = 0; /* 晋升/秒（进程起算均值） */
    var lastMissLine: Long = 0;
    var lastMissCol: Long = 0;
    /* v0.73 mspan */
    var spanCommitBytes: Long = 0; /* VirtualAlloc 未 Free */
    var freelistBytes: Long = 0; /* 空闲槽用户区 */
    var scavengeBytes: Long = 0; /* 累计归还 OS 字节 */
    var scavengeCycles: Long = 0;
    var spanCount: Long = 0;
    /* v0.74 GC-LAT-2：分段持锁 + 发布式 memstats */
    var lastCollectHoldMs: Long = 0;
    var lastUnlinkMs: Long = 0;
    var lastDrainMs: Long = 0;
    var lastScavengeMs: Long = 0;
    var lastStatsLockWaitMs: Long = 0;
    var lastPublishMs: Long = 0;
    var statsPublishCount: Long = 0;
    /* v0.75：stats 路径 safepoint/park 墙钟（诚实；非锁等） */
    var lastStatsSafepointMs: Long = 0;
}

extern func hao_gc_stats(dst: GcStats): Unit = "hao_gc_stats";

class GC {
    static var booted: Bool = false;

    // 安装语言 OOM 单例（进程内一次）。collect/stats/WeakRef/SoftRef 会自动调用。
    // 真 OOM 路径须先 boot，否则无 catcher 单例时仍 fatal。
    static func boot() {
        if (GC.booted) return;
        GC.booted = true;
        hao_gc_set_oom_exception(new exception.OutOfMemoryException("OutOfMemory"));
        hao_gc_ensure_oom_exc();
    }

    // 手动触发一次 major 收集（软 STW 根/终止 + 并发 mark + sweep；失败可 abort）。
    // 复杂度：与堆规模相关 O(堆块数 + 根扫描)
    // 副作用：collectCount +1；可能运行 finalizer（锁外）；阈值按存活字节重算
    // 注意：勿在应用层锁内随意调用（防与业务锁交叉死锁）
    static func collect() {
        GC.boot();
        gc_collect();
    }

    // 一次持锁读取全部核心指标（v0.53+；面板/摘要优先用这个）。
    // @return 新 GcStats 快照
    // 复杂度：O(1)
    static func stats(): GcStats {
        GC.boot();
        val s = new GcStats();
        hao_gc_stats(s);
        return s;
    }

    // 上次 **成功 major** 后仍存活的用户区字节。未成功 major 前常为 0——看当前堆压用 heapBytes。
    // @return 字节数
    // 复杂度：O(1)
    static func liveBytes(): Long {
        return hao_gc_live_bytes();
    }

    // 当前堆上用户区字节合计（alloc/sweep 维护；面板「托管堆」应优先看这个）。
    // @return 字节数
    // 复杂度：O(1)
    static func heapBytes(): Long {
        return hao_gc_heap_bytes();
    }

    // 触发下一次自动 major 回收的分配累计阈值（字节）。
    // @return 阈值；runtime 会夹在约 256KiB～256MiB
    // 复杂度：O(1)
    static func threshold(): Long {
        return hao_gc_threshold();
    }

    // 自上次 major 回收以来累计分配的用户对齐字节（达 threshold 会自动 major）。
    // @return 字节数
    // 复杂度：O(1)
    static func allocatedSinceGc(): Long {
        return hao_gc_allocated_since();
    }

    // 当前堆上 GC 块个数（含所有存活对象块）。
    // @return 块数
    // 复杂度：O(1)
    static func blockCount(): Long {
        return hao_gc_block_count();
    }

    // 已完成的 collect 次数（自动 minor/major + 手动 collect 均计入）。
    // @return 次数，从进程启动累计
    // 复杂度：O(1)
    static func collectCount(): Long {
        return hao_gc_collect_count();
    }

    // young/nursery 回收次数（minor）。对标 .NET GC.CollectionCount(0) / Gen0，非一一对应。
    // @return 次数
    // 复杂度：O(1)
    static func minorCount(): Long {
        return hao_gc_minor_count();
    }

    // 全堆回收次数（major）。对标 .NET GC.CollectionCount(2) / Gen2 量级；HaoLang 无 Gen1。
    // @return 次数
    // 复杂度：O(1)
    static func majorCount(): Long {
        return hao_gc_major_count();
    }

    // 当前 nursery 累计分配字节（触发 minor 的压力；非存活堆大小）。
    // @return 字节
    // 复杂度：O(1)
    static func nurseryBytes(): Long {
        return hao_gc_nursery_bytes();
    }

    // 已向 GC 注册、参与 STW 栈扫描的线程数（通常 ≤ OS 线程数）。
    // @return 线程数
    // 复杂度：O(1)
    static func registeredThreads(): Long {
        return hao_gc_registered_threads();
    }

    // finalizer 已执行次数（清扫不可达块后、锁外回调）。
    // @return 次数
    // 复杂度：O(1)
    static func finalizerRuns(): Long {
        return hao_gc_finalizer_runs();
    }

    // finalizer 成功挂接次数（调试用；含历史挂接，非当前挂接数）。
    // @return 次数
    // 复杂度：O(1)
    static func finalizerSets(): Long {
        return hao_gc_finalizer_sets();
    }

    // finalizer 回调被 SEH 隔离吞掉的次数（Win；防拖垮进程）。
    // @return 次数
    // 复杂度：O(1)
    static func finalizerExceptions(): Long {
        return hao_gc_finalizer_exceptions();
    }

    // STW 未齐 park 次数（v0.53：终止未齐则 abort MARK，不无限黑囤）。
    // @return 次数
    // 复杂度：O(1)
    static func stwIncomplete(): Long {
        return hao_gc_stw_incomplete();
    }
    /** v0.72：HOT_GRACE 已删，恒 0（ABI 保留） */
    static func stwGraceRescues(): Long {
        return hao_gc_stw_grace_rescues();
    }

    // mark assist 累计推进的 grey 块数（v0.52+）。
    // @return 次数
    // 复杂度：O(1)
    static func markAssistSteps(): Long {
        return hao_gc_mark_assist_steps();
    }

    // 历史「全标活」保底次数；v0.50.4 起恒为 0（已废除该路径）。
    // @return 恒 0
    // 复杂度：O(1)
    static func stwMarkAllFallbacks(): Long {
        return hao_gc_stw_mark_all_fallbacks();
    }

    // 已启动并发标记窗口的回收轮次（含随后 abort 的轮次）（v0.51+）。
    // @return 次数
    // 复杂度：O(1)
    static func concurrentMarkCycles(): Long {
        return hao_gc_concurrent_mark_cycles();
    }

    // 成功 concurrent sweep 轮次（默开；HAO_GC_STW_SWEEP=1 强制 STW free 时不涨）。
    // @return 次数
    // 复杂度：O(1)
    static func concurrentSweepCycles(): Long {
        return hao_gc_concurrent_sweep_cycles();
    }

    // exact-size freelist 累计入队次数（API 名 spanSweepChunks 保留）。
    // @return 次数
    // 复杂度：O(1)
    static func spanSweepChunks(): Long {
        return hao_gc_span_sweep_chunks();
    }

    // exact-size freelist alloc 命中次数（复用同尺寸块）。
    // @return 次数
    // 复杂度：O(1)
    static func freelistHits(): Long {
        return hao_gc_freelist_hits();
    }

    // 终止 STW 未齐导致 abort MARK 的次数（v0.53.3+；对标「回收压力/握手失败」）。
    // @return 次数
    // 复杂度：O(1)
    static func markAbortCycles(): Long {
        return hao_gc_mark_abort_cycles();
    }

    // GC 私有 mark worker 累计推进的 grey 块数（v0.54+）。
    // @return 次数
    // 复杂度：O(1)
    static func markWorkerSteps(): Long {
        return hao_gc_mark_worker_steps();
    }

    // 分代 remset 当前条目数（仅服务 minor 扫 old→young；major 不 seed）（v0.55.2+）。
    // @return 条目数
    // 复杂度：O(1)
    static func remsetCount(): Long {
        return hao_gc_remset_count();
    }

    // 人类可读摘要，便于 fmt.println 调试。
    // @return 多字段一行文本
    // 复杂度：O(1)（单次 stats）
    static func summary(): String {
        val s = GC.stats();
        return $"GC[v3] live={s.liveBytes}B heap={s.heapBytes}B threshold={s.threshold}B allocatedSince={s.allocatedSinceGc}B blocks={s.blockCount} collects={s.collectCount} minor={s.minorCount} major={s.majorCount} finalizerRuns={s.finalizerRuns} finalizerSets={s.finalizerSets} stwIncomplete={s.stwIncomplete} stwIncRoot={s.stwIncompleteRoot} stwIncTerm={s.stwIncompleteTerm} concurrentMark={s.concurrentMarkCycles} concurrentSweep={s.concurrentSweepCycles} markAssist={s.markAssistSteps} markAbort={s.markAbortCycles} abortRoot={s.markAbortRoot} abortTerm={s.markAbortTerm} abortParkWd={s.markAbortParkWd} markWorker={s.markWorkerSteps} remset={s.remsetCount} parkWd={s.parkWatchdogTrips} lastStwPhase={s.lastStwPhase} lastMissing={s.lastStwMissing}/{s.lastStwTargets} lastOsBlock={s.lastStwOsBlockMissing} missTid0={s.lastMissTid0} missAgeMs={s.lastMissMaxAgeMs} finDiag={s.lastFinalizerDiag}";
    }
}
