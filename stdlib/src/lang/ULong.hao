// ============================================================
//  lang.ULong —— 基础类型 ULong（u64）的包装类
// ============================================================
package lang;

import hash;

class ULong {
    var value: ULong;

    static val SIZE: Int = 64;
    static val BYTES: Int = 8;
    static val MAX_VALUE: ULong = 0xFFFFFFFFFFFFFFFF;
    static val MIN_VALUE: ULong = 0;

    constructor(v: ULong) {
        this.value = v;
    }

    static func valueOf(v: ULong): lang.ULong {
        return new lang.ULong(v);
    }

    func ulongValue(): ULong {
        return this.value;
    }

    // 0..9 Int → ULong（避免有符号/无符号隐式混合）
    static func digitU(d: Int): ULong {
        if (d == 0) { val z: ULong = 0; return z; }
        if (d == 1) { val z: ULong = 1; return z; }
        if (d == 2) { val z: ULong = 2; return z; }
        if (d == 3) { val z: ULong = 3; return z; }
        if (d == 4) { val z: ULong = 4; return z; }
        if (d == 5) { val z: ULong = 5; return z; }
        if (d == 6) { val z: ULong = 6; return z; }
        if (d == 7) { val z: ULong = 7; return z; }
        if (d == 8) { val z: ULong = 8; return z; }
        val z: ULong = 9;
        return z;
    }

    static func toStr(v: ULong): String {
        if (v == 0) { return "0"; }
        var x = v;
        var r = "";
        val ten: ULong = 10;
        while (x > 0) {
            val rem = x % ten;
            // rem 0..9 → Char
            var d = 0;
            if (rem == ULong.digitU(1)) { d = 1; }
            else if (rem == ULong.digitU(2)) { d = 2; }
            else if (rem == ULong.digitU(3)) { d = 3; }
            else if (rem == ULong.digitU(4)) { d = 4; }
            else if (rem == ULong.digitU(5)) { d = 5; }
            else if (rem == ULong.digitU(6)) { d = 6; }
            else if (rem == ULong.digitU(7)) { d = 7; }
            else if (rem == ULong.digitU(8)) { d = 8; }
            else if (rem == ULong.digitU(9)) { d = 9; }
            val ch: Char = 48 + d;
            r = Character.toStr(ch) + r;
            x = x / ten;
        }
        return r;
    }

    static func parse(s: String): ULong? {
        if (s.length == 0) { return null; }
        var i = 0;
        if (s[0] == '+') {
            i = 1;
            if (s.length == 1) { return null; }
        }
        if (s[0] == '-') { return null; }
        var acc: ULong = 0;
        var any = false;
        val ten: ULong = 10;
        val lim = ULong.MAX_VALUE / ten;
        while (i < s.length) {
            val c = s[i];
            if (c < '0' || c > '9') { return null; }
            val d: Int = c - 48;
            if (d < 0 || d > 9) { return null; }
            val du = ULong.digitU(d);
            if (acc > lim) { return null; }
            if (acc == lim && du > (ULong.MAX_VALUE % ten)) { return null; }
            acc = acc * ten + du;
            any = true;
            i = i + 1;
        }
        if (!any) { return null; }
        return acc;
    }

    static func compare(a: ULong, b: ULong): Int {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    func compareTo(other: lang.ULong): Int {
        return ULong.compare(this.value, other.value);
    }

    override func hashCode(): Int {
        return hash.hashOf(this.value);
    }

    override func equals(o: Object): Bool {
        if (!(o is lang.ULong)) { return false; }
        val other = o as lang.ULong;
        return this.value == other.value;
    }

    override func toString(): String {
        return ULong.toStr(this.value);
    }
}
