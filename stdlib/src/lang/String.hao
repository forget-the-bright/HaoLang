// ============================================================
//  lang.String —— 对标 Java java.lang.String（value 真字段，禁 C 跳板）
// ------------------------------------------------------------
//  内建 String：头 { value:[Byte], cpLen }；仅 lang/json 可读字段。
//  造串：fromUtf8 / fromUtf8Owned（object_new + 写字段）。
// ============================================================
package lang;

import hash;
import collections;

class String {
    var value: String;

    constructor(s: String) {
        this.value = s;
    }

    static func valueOf(s: String): lang.String {
        return new lang.String(s);
    }

    // 业务唯一造串：拷贝 bytes → 头对象 → 写 value/cpLen
    static func fromUtf8(bytes: [Byte]): String {
        val exact = collections.copyOf(bytes);
        return String.fromUtf8Owned(exact);
    }

    // 调用方交出独占 [Byte]（SB.toString / 字面量路径）
    static func fromUtf8Owned(bytes: [Byte]): String {
        val s = hao_object_new(2, 1);
        s.value = bytes;
        s.cpLen = Character.utf8CpCount(bytes);
        return s;
    }

    // 供 net/http/os/regex：公开字节长/切片（内部读 value）
    static func utf8ByteLen(s: String): Int {
        return s.value.length;
    }
    // 单字节（0..255）；越界 -1。供 HTTP ASCII 扫描，禁 per-byte utf8ByteSlice 造串
    static func utf8ByteAt(s: String, i: Int): Int {
        val n = s.value.length;
        if (i < 0 || i >= n) { return -1; }
        val b: Int = s.value[i];
        return b;
    }
    static func utf8ByteSlice(s: String, start: Int, end: Int): String {
        var a = start;
        var b = end;
        val n = s.value.length;
        if (a < 0) { a = 0; }
        if (b > n) { b = n; }
        if (b < a) { b = a; }
        // copyOfRange 已独占；fromUtf8Owned 免二次 copyOf
        return String.fromUtf8Owned(collections.copyOfRange(s.value, a, b));
    }

    static func concat(a: String, b: String): String {
        val n = a.value.length + b.value.length;
        val sb = StringBuilder.withCapacity(n);
        sb.append(a);
        sb.append(b);
        return sb.toString();
    }

    static func codePointLen(s: String): Long {
        val cached = s.cpLen;
        if (cached >= 0) { return cached; }
        val n = Character.utf8CpCount(s.value);
        s.cpLen = n;
        return n;
    }

    static func charAtCp(s: String, i: Long): Char {
        return Character.utf8CharAtCp(s.value, i);
    }

    static func contentHash(s: String): Int {
        val bytes = s.value;
        var h: Long = -3750763034362895579;
        var i = 0;
        while (i < bytes.length) {
            val b: Int = bytes[i];
            h = h ^ b;
            h = h * 1099511628211;
            i = i + 1;
        }
        val out: Int = h;
        return out;
    }

    static func fromInt(n: Int): lang.String {
        return new lang.String(Integer.toStr(n));
    }
    static func fromLong(n: Long): lang.String {
        return new lang.String(Long.toStr(n));
    }
    static func fromFloat(f: Float): lang.String {
        return new lang.String(Float.toStr(f));
    }
    static func fromDouble(d: Double): lang.String {
        return new lang.String(Double.toStr(d));
    }
    static func fromBool(b: Bool): lang.String {
        return new lang.String(Boolean.toStr(b));
    }
    static func fromBytes(arr: [Byte]): lang.String {
        return new lang.String(String.fromUtf8(arr));
    }

    static func compare(a: String, b: String): Int {
        val na = a.length;
        val nb = b.length;
        var n = na;
        if (nb < n) { n = nb; }
        var i = 0;
        while (i < n) {
            val ca = a[i];
            val cb = b[i];
            if (ca < cb) { return -1; }
            if (ca > cb) { return 1; }
            i = i + 1;
        }
        if (na < nb) { return -1; }
        if (na > nb) { return 1; }
        return 0;
    }

    static func byteIndexOf(s: String, sub: String, from: Int): Int {
        val a = s.value;
        val b = sub.value;
        val sl = a.length;
        val subl = b.length;
        var f = from;
        if (f < 0) { f = 0; }
        if (subl == 0) {
            if (f > sl) { return sl; }
            return f;
        }
        if (f > sl - subl) { return -1; }
        val lim = sl - subl;
        var i = f;
        while (i <= lim) {
            var ok = true;
            var j = 0;
            while (j < subl) {
                if (a[i + j] != b[j]) { ok = false; break; }
                j = j + 1;
            }
            if (ok) { return i; }
            i = i + 1;
        }
        return -1;
    }

    func length(): Int {
        return this.value.length;
    }
    func byteLength(): Int {
        return String.utf8ByteLen(this.value);
    }
    // 公开 API：拷贝 value（对齐 Java getBytes）
    func getBytes(): [Byte] {
        return collections.copyOf(this.value.value);
    }
    func isEmpty(): Bool {
        return this.value.length == 0;
    }
    func substring(start: Int, end: Int): String {
        val s = this.value;
        var a = start;
        var b = end;
        val n = s.length;
        if (a < 0) { a = 0; }
        if (b < a) { b = a; }
        if (a > n) { a = n; }
        if (b > n) { b = n; }
        val bytes = s.value;
        var b0 = Character.utf8ByteOfCp(bytes, a);
        var b1 = Character.utf8ByteOfCp(bytes, b);
        if (b0 < 0) { b0 = 0; }
        if (b1 < 0) { b1 = bytes.length; }
        return String.utf8ByteSlice(s, b0, b1);
    }
    func indexOf(sub: String): Int {
        return this.indexOf(sub, 0);
    }
    func indexOf(sub: String, from: Int): Int {
        val n = this.value.length;
        val m = sub.length;
        var f = from;
        if (f < 0) { f = 0; }
        if (m == 0) {
            if (f > n) { return n; }
            return f;
        }
        if (f >= n) { return -1; }
        if (m > n) { return -1; }
        val lim = n - m;
        var i = f;
        while (i <= lim) {
            if (this.substring(i, i + m) == sub) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    func lastIndexOf(sub: String): Int {
        val n = this.value.length;
        val m = sub.length;
        if (m == 0) { return n; }
        if (m > n) { return -1; }
        var last = -1;
        val lim = n - m;
        var i = 0;
        while (i <= lim) {
            if (this.substring(i, i + m) == sub) {
                last = i;
            }
            i = i + 1;
        }
        return last;
    }
    func contains(sub: String): Bool {
        return this.indexOf(sub) >= 0;
    }
    func startsWith(prefix: String): Bool {
        val n = prefix.length;
        if (n == 0) { return true; }
        if (n > this.value.length) { return false; }
        return this.substring(0, n) == prefix;
    }
    func endsWith(suffix: String): Bool {
        val n = suffix.length;
        val m = this.value.length;
        if (n == 0) { return true; }
        if (n > m) { return false; }
        return this.substring(m - n, m) == suffix;
    }
    func charAt(i: Int): Char {
        return this.value[i];
    }
    func trim(): String {
        val n = this.value.length;
        var a = 0;
        var b = n;
        while (a < b) {
            val c = this.value[a];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { break; }
            a = a + 1;
        }
        while (b > a) {
            val c = this.value[b - 1];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { break; }
            b = b - 1;
        }
        return this.substring(a, b);
    }
    func toUpperCase(): String {
        var r = "";
        val n = this.value.length;
        var i = 0;
        while (i < n) {
            var c = this.value[i];
            if (c >= 'a' && c <= 'z') {
                c = c - 32;
            }
            r = r + c;
            i = i + 1;
        }
        return r;
    }
    func toLowerCase(): String {
        var r = "";
        val n = this.value.length;
        var i = 0;
        while (i < n) {
            var c = this.value[i];
            if (c >= 'A' && c <= 'Z') {
                c = c + 32;
            }
            r = r + c;
            i = i + 1;
        }
        return r;
    }

    override func hashCode(): Int {
        return hash.hashOf(this.value);
    }
    override func equals(o: Object): Bool {
        if (!(o is lang.String)) { return false; }
        val other = o as lang.String;
        return this.value == other.value;
    }
    override func toString(): String {
        return this.value;
    }
}
