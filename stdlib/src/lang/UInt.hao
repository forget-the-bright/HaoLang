// ============================================================
//  lang.UInt —— 基础类型 UInt（u32）的包装类
// ============================================================
package lang;

class UInt {
    var value: UInt;

    static val SIZE: Int = 32;
    static val BYTES: Int = 4;
    static val MAX_VALUE: UInt = 4294967295;
    static val MIN_VALUE: UInt = 0;

    constructor(v: UInt) {
        this.value = v;
    }

    static func valueOf(v: UInt): lang.UInt {
        return new lang.UInt(v);
    }

    func uintValue(): UInt {
        return this.value;
    }

    static func toStr(v: UInt): String {
        if (v == 0) { return "0"; }
        var x: ULong = v;
        var r = "";
        val ten: ULong = 10;
        while (x > 0) {
            val rem = x % ten;
            var d = 0;
            if (rem == ULong.digitU(1)) { d = 1; }
            else if (rem == ULong.digitU(2)) { d = 2; }
            else if (rem == ULong.digitU(3)) { d = 3; }
            else if (rem == ULong.digitU(4)) { d = 4; }
            else if (rem == ULong.digitU(5)) { d = 5; }
            else if (rem == ULong.digitU(6)) { d = 6; }
            else if (rem == ULong.digitU(7)) { d = 7; }
            else if (rem == ULong.digitU(8)) { d = 8; }
            else if (rem == ULong.digitU(9)) { d = 9; }
            val ch: Char = 48 + d;
            r = Character.toStr(ch) + r;
            x = x / ten;
        }
        return r;
    }

    static func parse(s: String): UInt? {
        if (s.length == 0) { return null; }
        var i = 0;
        if (s[0] == '+') {
            i = 1;
            if (s.length == 1) { return null; }
        }
        if (s[0] == '-') { return null; }
        var acc: Long = 0;
        var any = false;
        while (i < s.length) {
            val c = s[i];
            if (c < '0' || c > '9') { return null; }
            val d: Int = c - 48;
            acc = acc * 10 + d;
            if (acc > 4294967295) { return null; }
            any = true;
            i = i + 1;
        }
        if (!any) { return null; }
        val r: UInt = acc;
        return r;
    }

    static func compare(a: UInt, b: UInt): Int {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    func compareTo(other: lang.UInt): Int {
        return UInt.compare(this.value, other.value);
    }

    override func hashCode(): Int {
        return this.value;
    }

    override func equals(o: Object): Bool {
        if (!(o is lang.UInt)) { return false; }
        val other = o as lang.UInt;
        return this.value == other.value;
    }

    override func toString(): String {
        return UInt.toStr(this.value);
    }
}
