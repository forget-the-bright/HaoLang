// ============================================================
//  lang.Character —— 基础类型 Char（Unicode 码点，i32）的包装类
// ------------------------------------------------------------
//  类名 Character，避免与内建 Char 冲突（对齐 Boolean/Integer）。
//  三种形态：内建 Char / Char?（hao_box_i32）/ 对象 Character
// ============================================================
package lang;

class Character {
    var value: Char;

    static val SIZE: Int = 32;
    static val BYTES: Int = 4;
    static val MIN_VALUE: Char = 0;
    static val MAX_VALUE: Char = 0x10FFFF;

    constructor(v: Char) {
        this.value = v;
    }

    static func valueOf(v: Char): Character {
        return new Character(v);
    }

    func charValue(): Char {
        return this.value;
    }

    func intValue(): Int {
        return this.value;
    }

    // UTF-8 编码 → fromBytes（定长缓冲，对齐 Java/C# 数组定长）
    static func toStr(v: Char): String {
        var cp: Int = v;
        if (cp < 0) { cp = 0xFFFD; }
        if (cp > 0x10FFFF) { cp = 0xFFFD; }
        if (cp <= 0x7F) {
            val arr = new [Byte](1);
            val b: Byte = cp;
            arr[0] = b;
            return hao_str_from_byte_arr(arr);
        }
        if (cp <= 0x7FF) {
            val arr = new [Byte](2);
            arr[0] = 0xC0 | (cp >> 6);
            arr[1] = 0x80 | (cp & 0x3F);
            return hao_str_from_byte_arr(arr);
        }
        if (cp <= 0xFFFF) {
            val arr = new [Byte](3);
            arr[0] = 0xE0 | (cp >> 12);
            arr[1] = 0x80 | ((cp >> 6) & 0x3F);
            arr[2] = 0x80 | (cp & 0x3F);
            return hao_str_from_byte_arr(arr);
        }
        val arr = new [Byte](4);
        arr[0] = 0xF0 | (cp >> 18);
        arr[1] = 0x80 | ((cp >> 12) & 0x3F);
        arr[2] = 0x80 | ((cp >> 6) & 0x3F);
        arr[3] = 0x80 | (cp & 0x3F);
        return hao_str_from_byte_arr(arr);
    }

    static func compare(a: Char, b: Char): Int {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    func compareTo(other: Character): Int {
        return Character.compare(this.value, other.value);
    }

    override func hashCode(): Int {
        return this.value;
    }

    override func equals(o: Object): Bool {
        if (!(o is Character)) { return false; }
        val other = o as Character;
        return this.value == other.value;
    }

    override func toString(): String {
        return Character.toStr(this.value);
    }

    // ---- UTF-8 解码（v0.79：串码点算法上移；禁再扩 hao_str_*）----
    static func utf8CpCount(bytes: [Byte]): Long {
        var i = 0;
        var n: Long = 0;
        val len = bytes.length;
        while (i < len) {
            val b: Int = bytes[i];
            if ((b & 0x80) == 0) { i = i + 1; }
            else if ((b & 0xE0) == 0xC0) { i = i + 2; }
            else if ((b & 0xF0) == 0xE0) { i = i + 3; }
            else if ((b & 0xF8) == 0xF0) { i = i + 4; }
            else { i = i + 1; }
            n = n + 1;
        }
        return n;
    }

    static func utf8ByteOfCp(bytes: [Byte], cpIdx: Int): Int {
        if (cpIdx < 0) { return -1; }
        var i = 0;
        var n = 0;
        val len = bytes.length;
        while (i < len) {
            if (n == cpIdx) { return i; }
            val b: Int = bytes[i];
            if ((b & 0x80) == 0) { i = i + 1; }
            else if ((b & 0xE0) == 0xC0) { i = i + 2; }
            else if ((b & 0xF0) == 0xE0) { i = i + 3; }
            else if ((b & 0xF8) == 0xF0) { i = i + 4; }
            else { i = i + 1; }
            n = n + 1;
        }
        if (n == cpIdx) { return len; }
        return -1;
    }

    // 从 byteIdx 解一个码点；返回码点，并通过 outNext 写下一字节下标（越界 -1）
    static func utf8CpAt(bytes: [Byte], byteIdx: Int): Char {
        if (byteIdx < 0 || byteIdx >= bytes.length) { return -1; }
        val b0: Int = bytes[byteIdx];
        if ((b0 & 0x80) == 0) {
            val c: Char = b0;
            return c;
        }
        if ((b0 & 0xE0) == 0xC0) {
            if (byteIdx + 1 >= bytes.length) { return -1; }
            val b1: Int = bytes[byteIdx + 1];
            val cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F);
            val c: Char = cp;
            return c;
        }
        if ((b0 & 0xF0) == 0xE0) {
            if (byteIdx + 2 >= bytes.length) { return -1; }
            val b1: Int = bytes[byteIdx + 1];
            val b2: Int = bytes[byteIdx + 2];
            val cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            val c: Char = cp;
            return c;
        }
        if ((b0 & 0xF8) == 0xF0) {
            if (byteIdx + 3 >= bytes.length) { return -1; }
            val b1: Int = bytes[byteIdx + 1];
            val b2: Int = bytes[byteIdx + 2];
            val b3: Int = bytes[byteIdx + 3];
            val cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
            val c: Char = cp;
            return c;
        }
        return -1;
    }

    static func utf8NextByte(bytes: [Byte], byteIdx: Int): Int {
        if (byteIdx < 0 || byteIdx >= bytes.length) { return -1; }
        val b0: Int = bytes[byteIdx];
        if ((b0 & 0x80) == 0) { return byteIdx + 1; }
        if ((b0 & 0xE0) == 0xC0) { return byteIdx + 2; }
        if ((b0 & 0xF0) == 0xE0) { return byteIdx + 3; }
        if ((b0 & 0xF8) == 0xF0) { return byteIdx + 4; }
        return byteIdx + 1;
    }

    static func utf8CharAtCp(bytes: [Byte], cpIdx: Long): Char {
        if (cpIdx < 0) { return -1; }
        val bi = Character.utf8ByteOfCp(bytes, cpIdx);
        if (bi < 0 || bi >= bytes.length) { return -1; }
        return Character.utf8CpAt(bytes, bi);
    }
}
