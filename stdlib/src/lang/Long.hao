// ============================================================
//  lang.Long —— 基础类型 Long（i64）的包装类
//  标注包装写 lang.Long；裸名 Long = 内建
// ============================================================
package lang;

import hash;

class Long {
    var value: Long;

    static val SIZE: Int = 64;
    static val BYTES: Int = 8;
    static val MAX_VALUE: Long = 9223372036854775807;
    static val MIN_VALUE: Long = 0 - 9223372036854775807 - 1;

    constructor(v: Long) {
        this.value = v;
    }

    static func valueOf(v: Long): lang.Long {
        return new lang.Long(v);
    }

    func longValue(): Long {
        return this.value;
    }

    static func parse(s: String): Long? {
        if (s.length == 0) { return null; }
        var i = 0;
        var neg = false;
        if (s[0] == '-') {
            neg = true;
            i = 1;
            if (s.length == 1) { return null; }
        } else if (s[0] == '+') {
            i = 1;
            if (s.length == 1) { return null; }
        }
        var acc: Long = 0;
        var any = false;
        while (i < s.length) {
            val c = s[i];
            if (c < '0' || c > '9') { return null; }
            val d: Int = c - 48;
            // 溢出：acc > MAX/10 或 ==MAX/10 且 digit 过大
            if (!neg) {
                if (acc > Long.MAX_VALUE / 10) { return null; }
                if (acc == Long.MAX_VALUE / 10 && d > 7) { return null; }
                acc = acc * 10 + d;
            } else {
                if (acc > Long.MAX_VALUE / 10) { return null; }
                if (acc == Long.MAX_VALUE / 10) {
                    if (d > 8) { return null; }
                    if (d == 8) {
                        // 仅允许完整 MIN：-9223372036854775808
                        if (i + 1 != s.length) { return null; }
                        return Long.MIN_VALUE;
                    }
                }
                acc = acc * 10 + d;
            }
            any = true;
            i = i + 1;
        }
        if (!any) { return null; }
        if (neg) { return 0 - acc; }
        return acc;
    }

    static func toStr(v: Long): String {
        val sb = StringBuilder.withCapacity(20);
        sb.append(v);
        return sb.toString();
    }

    static func compare(a: Long, b: Long): Int {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    func compareTo(other: lang.Long): Int {
        return Long.compare(this.value, other.value);
    }

    override func hashCode(): Int {
        return hash.hashOf(this.value);
    }

    override func equals(o: Object): Bool {
        if (!(o is lang.Long)) { return false; }
        val other = o as lang.Long;
        return this.value == other.value;
    }

    override func toString(): String {
        return Long.toStr(this.value);
    }
}
