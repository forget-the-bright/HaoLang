// ============================================================
//  lang.Integer —— 基础类型 Int（i32）的包装类
// ------------------------------------------------------------
//  三种形态：内建 Int / 可空 Int?（hao_box_i32）/ 对象 Integer
//  无隐式自动装箱；需要 Object 时显式 Integer.valueOf(n)
// ============================================================
package lang;

class Integer {
    var value: Int;

    static val SIZE: Int = 32;
    static val BYTES: Int = 4;
    static val MAX_VALUE: Int = 2147483647;
    static val MIN_VALUE: Int = 0 - 2147483647 - 1;

    constructor(v: Int) {
        this.value = v;
    }

    static func valueOf(v: Int): Integer {
        return new Integer(v);
    }

    func intValue(): Int {
        return this.value;
    }

    // v0.56：整型 parse/toStr 上移 Hao（删 hao_parse_int / hao_int_to_str）
    static func parse(s: String): Int? {
        if (s.length == 0) { return null; }
        var i = 0;
        var neg = false;
        if (s[0] == '-') {
            neg = true;
            i = 1;
            if (s.length == 1) { return null; }
        } else if (s[0] == '+') {
            i = 1;
            if (s.length == 1) { return null; }
        }
        var acc: Long = 0;
        var any = false;
        while (i < s.length) {
            val c = s[i];
            if (c < '0' || c > '9') { return null; }
            val d: Int = c - 48;
            acc = acc * 10 + d;
            any = true;
            if (!neg && acc > 2147483647) { return null; }
            if (neg && acc > 2147483648) { return null; }
            i = i + 1;
        }
        if (!any) { return null; }
        if (neg) {
            val r: Int = 0 - acc;
            return r;
        }
        val r: Int = acc;
        return r;
    }

    static func toStr(v: Int): String {
        if (v == 0) { return "0"; }
        if (v == Integer.MIN_VALUE) { return "-2147483648"; }
        var neg = false;
        var x: Long = v;
        if (v < 0) {
            neg = true;
            x = 0 - x;
        }
        var r = "";
        while (x > 0) {
            val d: Int = x % 10;
            val ch: Char = 48 + d;
            r = Character.toStr(ch) + r;
            x = x / 10;
        }
        if (neg) { return "-" + r; }
        return r;
    }

    static func compare(a: Int, b: Int): Int {
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    func compareTo(other: Integer): Int {
        return Integer.compare(this.value, other.value);
    }

    override func hashCode(): Int {
        return this.value;
    }

    override func equals(o: Object): Bool {
        if (!(o is Integer)) { return false; }
        val other = o as Integer;
        return this.value == other.value;
    }

    override func toString(): String {
        return Integer.toStr(this.value);
    }
}
