// ============================================================
//  lang 包 —— 运行时 extern 集中声明
// ============================================================
package lang;

extern func hao_float_to_str(v: Float): String = "hao_float_to_str";
extern func hao_double_to_str(v: Double): String = "hao_double_to_str";
extern func hao_parse_float(s: String): Float? = "hao_parse_float";
extern func hao_parse_double(s: String): Double? = "hao_parse_double";
extern func hao_str_len(s: String): Long = "hao_str_len";
extern func hao_str_concat(a: String, b: String): String = "hao_str_concat";
extern func hao_str_byte_len(s: String): Int = "hao_str_byte_len";
extern func hao_str_byte_of_cp(s: String, cpIdx: Int): Int = "hao_str_byte_of_cp";
extern func hao_str_byte_slice(s: String, start: Int, end: Int): String = "hao_str_byte_slice";
extern func hao_str_char_at(s: String, i: Long): Char = "hao_str_char_at";
extern func hao_str_get_bytes(s: String): [Byte] = "hao_str_get_bytes";
extern func hao_str_from_byte_arr(arr: [Byte]): String = "hao_str_from_byte_arr";
