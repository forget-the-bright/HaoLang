// HaoLang 标准库 —— thread 包
// Thread 句柄：NativeHandle（OS 线程资源代理）；禁 Long 藏针。
// drop=关闭 OS 句柄（不等待）；显式 join 才 Wait。长期 worker 可只 start 不 join。
// ThreadPool：NativeHandle 代理 Pool*（drop=shutdown+join+free）；禁 Long 藏针。
package thread;

class Thread {
    var handle: NativeHandle;

    constructor() {
        this.handle = NativeHandle.empty();
    }

    func start(run: ()->Unit): Bool {
        this.handle = hao_thread_start(run);
        return hao_handle_is_open(this.handle);
    }
    func join() {
        hao_thread_join(this.handle);
    }
}

class ThreadPool {
    var pool: NativeHandle;

    constructor() {
        this.pool = NativeHandle.empty();
    }

    func submit(run: ()->Unit): Bool {
        return hao_pool_submit(this.pool, run) == 0;
    }
    func shutdown() {
        hao_pool_shutdown(this.pool);
    }
}

func newPool(n: Int): ThreadPool {
    val p = new ThreadPool();
    p.pool = hao_pool_new(n);
    return p;
}

func sleep(ms: Int) {
    hao_thread_sleep_ms(ms);
}

func sleepNanos(ns: Long) {
    hao_thread_sleep_ns(ns);
}

func yield() {
    hao_thread_yield();
}

extern func hao_thread_sleep_ms(ms: Int): Unit = "hao_thread_sleep_ms";
extern func hao_thread_sleep_ns(ns: Long): Unit = "hao_thread_sleep_ns";
extern func hao_thread_yield(): Unit = "hao_thread_yield";
extern func hao_thread_start(run: ()->Unit): NativeHandle = "hao_thread_start";
extern func hao_thread_join(handle: NativeHandle): Unit = "hao_thread_join";
extern func hao_pool_new(n: Int): NativeHandle = "hao_pool_new";
extern func hao_pool_submit(pool: NativeHandle, run: ()->Unit): Int = "hao_pool_submit";
extern func hao_pool_shutdown(pool: NativeHandle): Unit = "hao_pool_shutdown";
