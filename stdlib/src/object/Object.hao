// HaoLang 标准库 —— object 包：Object 根父类（v0.15.0）
// ------------------------------------------------------------
//  所有类都默认继承 Object（编译器自动补齐基类，无需显式写）。
//  Object 提供三个默认实现（身份语义），子类可覆写：
//    hashCode()          身份哈希（对象地址）
//    equals(o: Object)   身份相等（指针相等）
//    toString()          "<0x地址>"
//  覆写 equals 时通常也要覆写 hashCode（与 Java/C# 一致），
//  以保证「相等对象哈希一致」。Map/Set 的对象 key 依赖这两个方法。
//
//  v0.79：三默认全 Hao（ptrOf 仅位型薄跳板；无 C 拼串）。
//
//  类型身份（对标 Java Class / 类字面量）：
//    - 每个类由编译器合成 static val Class: reflect.Class（每类型一份单例）
//    - 访问：Foo.Class（静态常量，经 ensureInit 填充）
//    - 实例：obj.getClass()（与 Foo.Class 同一对象）
package object;

import reflect;
import lang;

class Object {
    func hashCode(): Int {
        val p = reflect.ptrOf(this);
        val x = p ^ (p >> 32);
        val r: Int = x;
        return r;
    }
    func equals(o: Object): Bool {
        return reflect.ptrOf(this) == reflect.ptrOf(o);
    }
    func toString(): String {
        return Object.ptrAngle(reflect.ptrOf(this));
    }
    // Java Object.getClass()
    func getClass(): reflect.Class {
        return reflect.typeOf(this);
    }

    // "<0x" + 16 位小写 hex + ">"（固定容量 SB；禁 Character.toStr+）
    static func ptrAngle(p: Long): String {
        val sb = StringBuilder.withCapacity(19);
        sb.append('<');
        sb.append('0');
        sb.append('x');
        val hex = new [Char](16);
        var u = p;
        var i = 15;
        while (i >= 0) {
            val d: Int = u & 15;
            var cp: Char = 48 + d;
            if (d >= 10) { cp = 87 + d; }
            hex[i] = cp;
            u = u >> 4;
            i = i - 1;
        }
        i = 0;
        while (i < 16) {
            sb.append(hex[i]);
            i = i + 1;
        }
        sb.append('>');
        return sb.toString();
    }
}