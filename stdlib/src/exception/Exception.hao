// HaoLang 标准库 —— exception 包
// ----------------------------------------------
//  Exception：所有异常的统一基类。
//
//  用法：
//      import exception;
//
//      class MyError : exception.Exception {
//          constructor(msg: String) { this.message = msg; }
//      }
//
//      func main() {
//          try {
//              throw new MyError("出错了");
//          } catch (e: exception.Exception) {
//              fmt.println(e.getMessage());   // 出错了
//          }
//      }
//
//  实现说明：HaoLang 的 throw/catch 按对象虚表做运行时类型匹配，
//  天然支持继承——catch (Exception) 能捕获任何 Exception 子类。
//  本类是纯 .hao 实现，不依赖任何 C 运行时函数；throw 由编译器
//  内建展开为 @hao_throw。
package exception;

class Exception {
    // 异常信息。子类构造函数可直接设置此字段（当前版本无 super(...) 链，
    // 子类构造函数直接给继承字段赋值，与其它类的写法一致）。
    var message: String = "";

    constructor(message: String) {
        this.message = message;
    }

    func getMessage(): String {
        return this.message;
    }

    // 便于打印/调试的描述
    override func toString(): String {
        return $"Exception: {this.message}";
    }
}
