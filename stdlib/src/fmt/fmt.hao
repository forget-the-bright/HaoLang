package fmt;

// 标量 println：Hao toStr + 唯一 C 出口 hao_println_str（v0.57 P7a）
public func println(x: SByte) { println(SByte.toStr(x)); }
public func println(x: Byte) { println(Byte.toStr(x)); }
public func println(x: Short) { println(Short.toStr(x)); }
public func println(x: UShort) { println(UShort.toStr(x)); }
public func println(x: Int) { println(Integer.toStr(x)); }
public func println(x: UInt) { println(UInt.toStr(x)); }
public func println(x: Long) { println(Long.toStr(x)); }
public func println(x: ULong) { println(ULong.toStr(x)); }
public func println(x: Float) { println(Float.toStr(x)); }
public func println(x: Double) { println(Double.toStr(x)); }
public func println(x: Bool) { println(Boolean.toStr(x)); }
public func println(x: Char) { println(Character.toStr(x)); }
public extern func println(x: String) = "hao_println_str";

// 任意 Object（含 lang 包装类）→ toString 后打印
func println(x: Object) {
    println(x.toString());
}

public extern func print(x: String) = "hao_print_str";
