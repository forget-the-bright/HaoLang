package fmt;

// 全数值族 + Bool/String/Object（v0.26）
public extern func println(x: SByte) = "hao_println_sbyte";
public extern func println(x: Byte) = "hao_println_byte";
public extern func println(x: Short) = "hao_println_short";
public extern func println(x: UShort) = "hao_println_ushort";
public extern func println(x: Int) = "hao_println_int";
public extern func println(x: UInt) = "hao_println_uint";
public extern func println(x: Long) = "hao_println_long";
public extern func println(x: ULong) = "hao_println_ulong";
public extern func println(x: Float) = "hao_println_float";
public extern func println(x: Double) = "hao_println_double";
public extern func println(x: Bool) = "hao_println_bool";
public extern func println(x: Char) = "hao_println_char";
public extern func println(x: String) = "hao_println_str";

// 任意 Object（含 lang 包装类）→ toString 后打印
func println(x: Object) {
    println(x.toString());
}

public extern func print(x: String) = "hao_print_str";
