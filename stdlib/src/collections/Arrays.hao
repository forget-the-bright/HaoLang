// HaoLang 标准库 —— collections.Arrays
// ----------------------------------------------
//  对标 Java java.util.Arrays + System.arraycopy / C# Array.Copy。
//  数组对象定长（.length）；块拷贝走永久 C hao_arraycopy。
//  数组 +=/pop 已废（v0.78）；可增长用 ArrayList。
package collections;

import exception;

extern func _arraycopy(dst: Array, dstPos: Long, src: Array, srcPos: Long, n: Long) = "hao_arraycopy";

// 对标 System.arraycopy / Array.Copy。
func arraycopy<T>(src: [T], srcPos: Int, dest: [T], destPos: Int, length: Int) {
    if (length < 0 || srcPos < 0 || destPos < 0) {
        throw new exception.Exception("Arrays.arraycopy：下标/长度非法");
    }
    if (srcPos > src.length - length || destPos > dest.length - length) {
        throw new exception.Exception("Arrays.arraycopy：越界");
    }
    if (length == 0) { return; }
    val sp: Long = srcPos;
    val dp: Long = destPos;
    val n: Long = length;
    _arraycopy(dest, dp, src, sp, n);
}

func isEmpty<T>(a: [T]): Bool {
    return a.length == 0;
}

func contains<T>(a: [T], item: T): Bool {
    var i = 0;
    while (i < a.length) {
        if (a[i] == item) {
            return true;
        }
        i += 1;
    }
    return false;
}

func indexOf<T>(a: [T], item: T): Int {
    var i = 0;
    while (i < a.length) {
        if (a[i] == item) {
            return i;
        }
        i += 1;
    }
    return -1;
}

func lastIndexOf<T>(a: [T], item: T): Int {
    var i = a.length - 1;
    while (i >= 0) {
        if (a[i] == item) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

func equals<T>(a: [T], b: [T]): Bool {
    if (a.length != b.length) {
        return false;
    }
    var i = 0;
    while (i < a.length) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

// 浅拷贝（arraycopy）
func copyOf<T>(a: [T]): [T] {
    val n = a.length;
    val out = new [T](n);
    if (n > 0) {
        val nl: Long = n;
        _arraycopy(out, 0, a, 0, nl);
    }
    return out;
}

func copyOfLength<T>(a: [T], newLength: Int): [T] {
    if (newLength < 0) {
        throw new exception.Exception("Arrays.copyOfLength：newLength 非法");
    }
    val out = new [T](newLength);
    var lim = a.length;
    if (lim > newLength) {
        lim = newLength;
    }
    if (lim > 0) {
        val nl: Long = lim;
        _arraycopy(out, 0, a, 0, nl);
    }
    return out;
}

func copyOfRange<T>(a: [T], from: Int, to: Int): [T] {
    if (from < 0 || to < from || to > a.length) {
        throw new exception.Exception("Arrays.copyOfRange：区间非法");
    }
    val n = to - from;
    val out = new [T](n);
    if (n > 0) {
        val nl: Long = n;
        val fr: Long = from;
        _arraycopy(out, 0, a, fr, nl);
    }
    return out;
}

func fill<T>(a: [T], value: T) {
    var i = 0;
    while (i < a.length) {
        a[i] = value;
        i += 1;
    }
}
