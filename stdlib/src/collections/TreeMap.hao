package collections;

// ============================================================
//  TreeMap<K,V> —— 有序映射（对标 Java TreeMap）
// ------------------------------------------------------------
//  实现 collections.Map；内部委托 RedBlackTree。
//  排序：构造器传入 compare（Func<K,K,Int>）。
// ============================================================

class TreeMap<K, V> : Map<K, V> {
    var tree: RedBlackTree<K, V>;

    constructor(compare: Func<K, K, Int>) {
        this.tree = new RedBlackTree<K, V>(compare);
    }

    func size(): Int { return this.tree.size(); }

    func isEmpty(): Bool { return this.tree.isEmpty(); }

    func put(key: K, value: V) { this.tree.put(key, value); }

    func get(key: K): V? { return this.tree.get(key); }

    func containsKey(key: K): Bool { return this.tree.containsKey(key); }

    func remove(key: K): Bool { return this.tree.remove(key); }

    func keys(): [K] { return this.tree.inorderKeys(); }

    func valueArray(): [V] {
        val ks = this.keys();
        var out: [V] = [];
        var i = 0;
        while (i < ks.length) {
            out += this.get(ks[i])!!;
            i += 1;
        }
        return out;
    }

    func keySet(): Iterable<K> {
        return new ArrayIterable<K>(this.keys());
    }

    func values(): Iterable<V> {
        return new ArrayIterable<V>(this.valueArray());
    }

    func entrySet(): Iterable<MapEntry<K, V>> {
        val ks = this.keys();
        var out: [MapEntry<K, V>] = [];
        var i = 0;
        while (i < ks.length) {
            val k = ks[i];
            val ent: MapEntry<K, V> = new SimpleMapEntry<K, V>(k, this.get(k)!!);
            out += ent;
            i += 1;
        }
        return new ArrayIterable<MapEntry<K, V>>(out);
    }

    func clear() {
        val cmp = this.tree.compare;
        this.tree = new RedBlackTree<K, V>(cmp);
    }
}
