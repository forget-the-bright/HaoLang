package collections;

import hash.*;
import exception;

// ============================================================
//  HashMap<K,V> —— 开放寻址哈希表（对标 Java HashMap）
// ------------------------------------------------------------
//  实现 collections.Map；无序；单线程（并发用 ConcurrentHashMap）。
//  散列/相等：hash 包顶层重载 hashOf/equalsKey。
//  探测：线性探测；负载 0.7 倍增；删除 tombstone。
//  迭代：keySet/values/entrySet → Iterable（快照 ArrayIterable）。
//  便利：keys(): [K] 数组快照（非接口方法）。
// ============================================================

// 表槽：null=空槽；occupied=false=tombstone；occupied=true=有效。
class HashMapBucket<K, V> {
    var key: K;
    var value: V;
    var occupied: Bool;
    constructor(k: K, v: V) {
        this.key = k;
        this.value = v;
        this.occupied = true;
    }
}

class HashMap<K, V> : Map<K, V> {
    var table: [HashMapBucket<K,V>?];
    var count: Int;
    var capacity: Int;
    var growthEnabled: Bool;

    constructor() {
        this.capacity = 16;
        this.count = 0;
        this.growthEnabled = true;
        this.table = new [HashMapBucket<K,V>?]{};
        var i = 0;
        while (i < 16) {
            this.table += null;
            i += 1;
        }
    }

    func size(): Int { return this.count; }

    func isEmpty(): Bool { return this.count == 0; }

    func resize() {
        if (!this.growthEnabled) { return; }
        if (this.capacity <= 0 || this.capacity > 1073741823) { return; }
        val old = this.table;
        this.capacity = this.capacity * 2;
        this.table = new [HashMapBucket<K,V>?]{};
        this.count = 0;
        var i = 0;
        while (i < this.capacity) {
            this.table += null;
            i += 1;
        }
        var j = 0;
        while (j < old.length) {
            val e = old[j];
            if (e != null && e!!.occupied) {
                this.insertUnchecked(e!!.key, e!!.value);
            }
            j += 1;
        }
    }

    func put(key: K, value: V) {
        val c: Long = this.count;
        val cap: Long = this.capacity;
        if (cap > 0 && c * 10 >= cap * 7) { this.resize(); }
        this.insertUnchecked(key, value);
    }

    func insertUnchecked(key: K, value: V) {
        if (this.capacity <= 0) {
            throw new exception.Exception("HashMap.put 失败：无效容量");
        }
        var idx = hashOf(key) % this.capacity;
        if (idx < 0) idx = -idx;
        var tomb = -1;
        var i = 0;
        while (i < this.capacity) {
            val e = this.table[idx];
            if (e == null) {
                if (tomb >= 0) {
                    val slot = this.table[tomb]!!;
                    slot.key = key;
                    slot.value = value;
                    slot.occupied = true;
                    this.count += 1;
                } else {
                    this.table[idx] = new HashMapBucket<K,V>(key, value);
                    this.count += 1;
                }
                return;
            }
            if (!e!!.occupied) {
                if (tomb < 0) tomb = idx;
            } else if (equalsKey(e!!.key, key)) {
                val slot = this.table[idx]!!;
                slot.value = value;
                return;
            }
            idx += 1;
            if (idx >= this.capacity) idx = 0;
            i += 1;
        }
        val oldCap = this.capacity;
        this.resize();
        if (this.capacity <= oldCap) {
            throw new exception.Exception("HashMap.put 失败：表已满且无法扩容");
        }
        this.insertUnchecked(key, value);
    }

    func get(key: K): V? {
        if (this.capacity <= 0) { return null; }
        var idx = hashOf(key) % this.capacity;
        if (idx < 0) idx = -idx;
        var i = 0;
        while (i < this.capacity) {
            val e = this.table[idx];
            if (e == null) return null;
            if (e!!.occupied && equalsKey(e!!.key, key)) {
                return this.table[idx]!!.value;
            }
            idx += 1;
            if (idx >= this.capacity) idx = 0;
            i += 1;
        }
        return null;
    }

    func containsKey(key: K): Bool {
        if (this.capacity <= 0) { return false; }
        var idx = hashOf(key) % this.capacity;
        if (idx < 0) idx = -idx;
        var i = 0;
        while (i < this.capacity) {
            val e = this.table[idx];
            if (e == null) return false;
            if (e!!.occupied && equalsKey(e!!.key, key)) return true;
            idx += 1;
            if (idx >= this.capacity) idx = 0;
            i += 1;
        }
        return false;
    }

    func remove(key: K): Bool {
        if (this.capacity <= 0) { return false; }
        var idx = hashOf(key) % this.capacity;
        if (idx < 0) idx = -idx;
        var i = 0;
        while (i < this.capacity) {
            val e = this.table[idx];
            if (e == null) return false;
            if (e!!.occupied && equalsKey(e!!.key, key)) {
                val slot = this.table[idx]!!;
                slot.occupied = false;
                this.count -= 1;
                return true;
            }
            idx += 1;
            if (idx >= this.capacity) idx = 0;
            i += 1;
        }
        return false;
    }

    func clear() {
        this.capacity = 16;
        this.count = 0;
        this.table = new [HashMapBucket<K,V>?]{};
        var i = 0;
        while (i < 16) {
            this.table += null;
            i += 1;
        }
    }

    func putIfAbsent(key: K, value: V): V? {
        if (this.containsKey(key)) { return this.get(key); }
        this.put(key, value);
        return null;
    }

    func getOrDefault(key: K, def: V): V {
        if (this.containsKey(key)) {
            return this.get(key)!!;
        }
        return def;
    }

    func containsValue(value: V): Bool {
        var i = 0;
        while (i < this.table.length) {
            val e = this.table[i];
            if (e != null && e!!.occupied && equalsKey(e!!.value, value)) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // 便利：键数组快照（非 Map 接口；套件/内部用）
    func keys(): [K] {
        var out: [K] = new [K]{};
        var i = 0;
        while (i < this.table.length) {
            val e = this.table[i];
            if (e != null && e!!.occupied) {
                out += e!!.key;
            }
            i += 1;
        }
        return out;
    }

    func valueArray(): [V] {
        var out: [V] = new [V]{};
        var i = 0;
        while (i < this.table.length) {
            val e = this.table[i];
            if (e != null && e!!.occupied) {
                out += e!!.value;
            }
            i += 1;
        }
        return out;
    }

    func keySet(): Iterable<K> {
        return new ArrayIterable<K>(this.keys());
    }

    func values(): Iterable<V> {
        return new ArrayIterable<V>(this.valueArray());
    }

    func entrySet(): Iterable<MapEntry<K, V>> {
        var out: [MapEntry<K, V>] = new [MapEntry<K, V>]{};
        var i = 0;
        while (i < this.table.length) {
            val e = this.table[i];
            if (e != null && e!!.occupied) {
                val ent: MapEntry<K, V> = new SimpleMapEntry<K, V>(e!!.key, e!!.value);
                out += ent;
            }
            i += 1;
        }
        return new ArrayIterable<MapEntry<K, V>>(out);
    }
}
