// HaoLang 标准库 —— collections 包
// ----------------------------------------------
//  List<T>：序列接口（对标 Java java.util.List）。
//  ArrayList<T>：对标 Java ArrayList / C# List —— elementData + size。
//  线程安全：否。随机访问 O(1)，中部删除 O(n)。
package collections;

import exception;

interface List<T> : Iterable<T> {
    func size(): Int;
    func add(item: T);
    func get(index: Int): T;
    func set(index: Int, item: T);
    func removeAt(index: Int): T;
    func isEmpty(): Bool;
    func contains(item: T): Bool;
    func indexOf(item: T): Int;
    func lastIndexOf(item: T): Int;
    func remove(item: T): Bool;
    func addAll(items: [T]);
    func clear();
}

class ArrayList<T> : List<T> {
    var elementData: [T];
    var count: Int;

    constructor() {
        this.elementData = new [T](10);
        this.count = 0;
    }

    static func withCapacity(capacity: Int): ArrayList<T> {
        val list = new ArrayList<T>();
        var c = capacity;
        if (c < 0) { c = 0; }
        if (c < 10) { c = 10; }
        list.elementData = new [T](c);
        list.count = 0;
        return list;
    }

    func iterator(): Iterator<T> {
        return new ArrayIterator<T>(this.toArray());
    }

    func size(): Int {
        return this.count;
    }

    func ensureCapacity(minCapacity: Int) {
        if (this.elementData.length >= minCapacity) { return; }
        var nc = this.elementData.length * 2;
        if (nc < minCapacity) { nc = minCapacity; }
        if (nc < 10) { nc = 10; }
        val old = this.elementData;
        val neu = new [T](nc);
        if (this.count > 0) {
            val n: Long = this.count;
            _arraycopy(neu, 0, old, 0, n);
        }
        this.elementData = neu;
    }

    func add(item: T) {
        this.ensureCapacity(this.count + 1);
        this.elementData[this.count] = item;
        this.count = this.count + 1;
    }

    func get(index: Int): T {
        if (index < 0 || index >= this.count) {
            throw new exception.Exception("ArrayList.get：越界");
        }
        return this.elementData[index];
    }

    func set(index: Int, item: T) {
        if (index < 0 || index >= this.count) {
            throw new exception.Exception("ArrayList.set：越界");
        }
        this.elementData[index] = item;
    }

    func removeAt(index: Int): T {
        if (index < 0 || index >= this.count) {
            throw new exception.Exception("ArrayList.removeAt：越界");
        }
        val removed = this.elementData[index];
        val moved = this.count - index - 1;
        if (moved > 0) {
            val m: Long = moved;
            val ip1: Long = index + 1;
            val ix: Long = index;
            _arraycopy(this.elementData, ix, this.elementData, ip1, m);
        }
        this.count = this.count - 1;
        return removed;
    }

    func isEmpty(): Bool {
        return this.count == 0;
    }

    func contains(item: T): Bool {
        return this.indexOf(item) >= 0;
    }

    func indexOf(item: T): Int {
        var i = 0;
        while (i < this.count) {
            if (this.elementData[i] == item) {
                return i;
            }
            i += 1;
        }
        return -1;
    }

    func lastIndexOf(item: T): Int {
        var i = this.count - 1;
        while (i >= 0) {
            if (this.elementData[i] == item) {
                return i;
            }
            i -= 1;
        }
        return -1;
    }

    func remove(item: T): Bool {
        val idx = this.indexOf(item);
        if (idx < 0) {
            return false;
        }
        this.removeAt(idx);
        return true;
    }

    func addAll(items: [T]) {
        var i = 0;
        while (i < items.length) {
            this.add(items[i]);
            i += 1;
        }
    }

    func clear() {
        this.elementData = new [T](10);
        this.count = 0;
    }

    func toArray(): [T] {
        val out = new [T](this.count);
        if (this.count > 0) {
            val n: Long = this.count;
            _arraycopy(out, 0, this.elementData, 0, n);
        }
        return out;
    }

    func map<R>(f: (T) -> R): List<R> {
        val result = new ArrayList<R>();
        var i = 0;
        while (i < this.count) {
            result.add(f(this.elementData[i]));
            i += 1;
        }
        return result;
    }

    func filter(f: (T) -> Bool): List<T> {
        val result = new ArrayList<T>();
        var i = 0;
        while (i < this.count) {
            if (f(this.elementData[i])) {
                result.add(this.elementData[i]);
            }
            i += 1;
        }
        return result;
    }

    func forEach(f: (T) -> Unit) {
        var i = 0;
        while (i < this.count) {
            f(this.elementData[i]);
            i += 1;
        }
    }
}
