// HaoLang 标准库 —— sync 并发原语
// 原子胞：NativeHandle 代理 malloc(8)（drop=free）；禁 Long? 藏针。
package sync;

public class Mutex {
    var state: NativeHandle;
    public constructor() {
        this.state = hao_sync_cell_new();
    }
    public func lock() {
        while (!atomicCompareExchange(this.state, 0, 1)) {
            hao_gc_safepoint();
        }
    }
    public func unlock() {
        atomicExchange(this.state, 0);
    }
}

public extern func atomicAdd(p: NativeHandle, delta: Long): Long = "hao_sync_atomic_add";
public extern func atomicFetchAdd(p: NativeHandle, delta: Long): Long = "hao_sync_atomic_fetch_add";
public extern func atomicExchange(p: NativeHandle, value: Long): Long = "hao_sync_atomic_exchange";
public extern func atomicCompareExchange(p: NativeHandle, expected: Long, desired: Long): Bool = "hao_sync_atomic_compare_exchange";
extern func hao_gc_safepoint(): Unit = "hao_gc_safepoint";
public extern func hao_sync_cell_new(): NativeHandle = "hao_sync_cell_new";
