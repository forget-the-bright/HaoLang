// ============================================================
//  net.ByteBuf —— 连接入站累积缓冲（对标 Netty ByteBuf 子集）
// ------------------------------------------------------------
//  v0.76：内部 lang.StringBuilder（禁 data = data + s 假缓冲）。
// ============================================================
package net;

import lang;

public class ByteBuf {
    var sb: lang.StringBuilder;
    var readerIndex: Int;

    constructor() {
        this.sb = new lang.StringBuilder();
        this.readerIndex = 0;
    }

    func writeBytes(s: String) {
        if (_bbLen(s) == 0) { return; }
        this.sb.append(s);
    }

    func readableBytes(): Int {
        val n = this.sb.byteLength();
        if (this.readerIndex >= n) { return 0; }
        return n - this.readerIndex;
    }

    func readableSlice(): String {
        val n = this.sb.byteLength();
        val all = this.sb.toString();
        if (this.readerIndex <= 0) { return all; }
        if (this.readerIndex >= n) { return ""; }
        return _bbSlice(all, this.readerIndex, n);
    }

    func skipBytes(n: Int) {
        if (n <= 0) { return; }
        var ri = this.readerIndex + n;
        val total = this.sb.byteLength();
        if (ri > total) { ri = total; }
        this.readerIndex = ri;
    }

    func readBytes(n: Int): String {
        val avail = this.readableBytes();
        var take = n;
        if (take > avail) { take = avail; }
        if (take <= 0) { return ""; }
        val all = this.sb.toString();
        val s = _bbSlice(all, this.readerIndex, this.readerIndex + take);
        this.readerIndex = this.readerIndex + take;
        return s;
    }

    func discardReadBytes() {
        if (this.readerIndex <= 0) { return; }
        val n = this.sb.byteLength();
        if (this.readerIndex >= n) {
            this.sb.clear();
            this.readerIndex = 0;
            return;
        }
        val all = this.sb.toString();
        val rest = _bbSlice(all, this.readerIndex, n);
        this.sb.clear();
        this.sb.append(rest);
        this.readerIndex = 0;
    }

    func clear() {
        this.sb.clear();
        this.readerIndex = 0;
    }
}

extern func _bbLen(s: String): Int = "hao_str_byte_len";
extern func _bbSlice(s: String, start: Int, end: Int): String = "hao_str_byte_slice";
