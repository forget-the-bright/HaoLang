// ============================================================
//  net.Mvc —— Spring Boot MVC 风格 HTTP 应用（v0.29）
// ------------------------------------------------------------
//  - 注解：@Controller / @RequestMapping / @GetMapping / @PostMapping …
//  - register(controller) 或 scan(packagePath) 绑路由（v0.30 支持嵌套包）
//  - 自定义 get/post/route 注册；过滤器链 + 拦截器
//  - HttpApp.serve / serveOnce 分派
// ============================================================
package net;

import collections;
import os;
import reflect;
import text;
import thread;

// ---- 路由注解（对标 Spring MVC；参数运行时可读）----
@interface Controller {
    val value: String = "";
}

@interface RequestMapping {
    val path: String = "";
    val method: String = "";
}

@interface GetMapping {
    val path: String = "";
}

@interface PostMapping {
    val path: String = "";
}

@interface PutMapping {
    val path: String = "";
}

@interface DeleteMapping {
    val path: String = "";
}

func mvcNoFn(req: HttpRequest): HttpResponse {
    return HttpResponse.of(500, "no fn");
}

// 过滤器链末端：调用 HttpApp 路由分派（避免 Func 字段/lambda 推断坑）
public class RouteTerminal {
    var app: HttpApp?;
    constructor() { this.app = null; }
    func handle(req: HttpRequest): HttpResponse {
        if (this.app == null) { return HttpResponse.of(404, "no handler"); }
        return this.app!!.invokeRoute(req);
    }
}

// ---- 过滤器 / 拦截器 ----
public class FilterChain {
    var filters: [HttpFilter];
    var index: Int;
    var terminal: RouteTerminal;

    constructor() {
        this.filters = [];
        this.index = 0;
        this.terminal = new RouteTerminal();
    }

    func proceed(req: HttpRequest): HttpResponse {
        if (this.index >= this.filters.length) {
            return this.terminal.handle(req);
        }
        val f = this.filters[this.index];
        this.index = this.index + 1;
        return f.doFilter(req, this);
    }
}

public class HttpFilter {
    func doFilter(req: HttpRequest, chain: FilterChain): HttpResponse {
        return chain.proceed(req);
    }
}

public class HandlerInterceptor {
    // 返回 false 则中止（应已写好 response 语义由调用方处理：返回 403）
    func preHandle(req: HttpRequest): Bool {
        return true;
    }
    func postHandle(req: HttpRequest, resp: HttpResponse) {}
}

class RouteBinding {
    var ctrl: Object?;
    var methodName: String;
    var hasFn: Bool;
    var fn: (HttpRequest) -> HttpResponse;

    constructor() {
        this.ctrl = null;
        this.methodName = "";
        this.hasFn = false;
        this.fn = mvcNoFn;
    }
}

class StaticMount {
    var prefix: String;
    var root: String;
    constructor(prefix: String, root: String) {
        this.prefix = prefix;
        this.root = root;
    }
}

public class HttpApp {
    var server: ServerSocket;
    var port: Int;
    var routes: collections.Map<String, RouteBinding>;
    var filters: [HttpFilter];
    var interceptors: [HandlerInterceptor];
    var running: Bool;
    var staticMounts: [StaticMount];

    constructor() {
        this.server = new ServerSocket();
        this.port = 0;
        this.routes = new collections.Map<String, RouteBinding>();
        this.filters = [];
        this.interceptors = [];
        this.running = false;
        this.staticMounts = [];
    }

    // v0.49：挂载静态目录；GET urlPrefix/... → root/...
    func staticFiles(urlPrefix: String, dir: String) {
        var p = urlPrefix;
        if (p.length == 0) { p = "/"; }
        if (!String.valueOf(p).startsWith("/")) { p = "/" + p; }
        if (p.length > 1 && String.valueOf(p).endsWith("/")) {
            p = String.valueOf(p).substring(0, p.length - 1);
        }
        this.staticMounts += new StaticMount(p, dir);
    }

    func listen(port: Int): Bool {
        this.port = port;
        return this.server.listen(port);
    }

    func close() {
        this.running = false;
        this.server.close();
    }

    func addFilter(f: HttpFilter) {
        this.filters += f;
    }

    func addInterceptor(i: HandlerInterceptor) {
        this.interceptors += i;
    }

    // ---- 显式路径注册 ----
    func get(path: String, handler: (HttpRequest) -> HttpResponse) {
        this.route("GET", path, handler);
    }

    func post(path: String, handler: (HttpRequest) -> HttpResponse) {
        this.route("POST", path, handler);
    }

    func put(path: String, handler: (HttpRequest) -> HttpResponse) {
        this.route("PUT", path, handler);
    }

    func delete(path: String, handler: (HttpRequest) -> HttpResponse) {
        this.route("DELETE", path, handler);
    }

    func route(method: String, path: String, handler: (HttpRequest) -> HttpResponse) {
        val b = new RouteBinding();
        b.hasFn = true;
        b.fn = handler;
        this.routes.put(HttpApp.routeKey(method, path), b);
    }

    // ---- 注解控制层：扫描实例方法上的映射注解（v0.50：Class 令牌）----
    func register(ctrl: Object) {
        val t = reflect.typeOf(ctrl);
        var base = "";
        val cv = t.getAnnotationValueFor(Controller.Class);
        if (cv != null) {
            val p = HttpApp.annoPath(cv!!);
            if (p.length > 0) { base = p; }
        }
        val rv = t.getAnnotationValueFor(RequestMapping.Class);
        if (rv != null) {
            val p = HttpApp.annoPath(rv!!);
            if (p.length > 0) { base = p; }
        }
        var mi = 0;
        while (mi < t.getMethodCount()) {
            val mname = t.getMethodName(mi);
            var httpMethod = "";
            var path = "";
            if (t.isMethodAnnotationPresent(mi, GetMapping.Class)) {
                httpMethod = "GET";
                path = HttpApp.annoPath(t.getMethodAnnotationValueFor(mi, GetMapping.Class) ?? "");
            } else if (t.isMethodAnnotationPresent(mi, PostMapping.Class)) {
                httpMethod = "POST";
                path = HttpApp.annoPath(t.getMethodAnnotationValueFor(mi, PostMapping.Class) ?? "");
            } else if (t.isMethodAnnotationPresent(mi, PutMapping.Class)) {
                httpMethod = "PUT";
                path = HttpApp.annoPath(t.getMethodAnnotationValueFor(mi, PutMapping.Class) ?? "");
            } else if (t.isMethodAnnotationPresent(mi, DeleteMapping.Class)) {
                httpMethod = "DELETE";
                path = HttpApp.annoPath(t.getMethodAnnotationValueFor(mi, DeleteMapping.Class) ?? "");
            } else if (t.isMethodAnnotationPresent(mi, RequestMapping.Class)) {
                val av = t.getMethodAnnotationValueFor(mi, RequestMapping.Class) ?? "";
                httpMethod = HttpApp.annoMethod(av);
                if (httpMethod.length == 0) { httpMethod = "GET"; }
                path = HttpApp.annoPath(av);
            }
            if (httpMethod.length > 0) {
                val full = HttpApp.joinPath(base, path);
                val b = new RouteBinding();
                b.ctrl = ctrl;
                b.methodName = mname;
                this.routes.put(HttpApp.routeKey(httpMethod, full), b);
            }
            mi += 1;
        }
    }

    // ---- 包扫描（v0.30～0.32）：扫描已链接进进程的类元数据 ----
    // path：demo/web、demo.web 均可；默认含嵌套子包（demo/web/api）
    // 注意：
    //   1) 控制器所在包必须被 import，否则不会进二进制、扫不到。
    //   2) 仅自动 new 无参构造（canNewInstance）；多参请 registerNewArgs / register。
    //   3) 可扩展条件用 scanWhere / reflect.findTypes（谓词自定）。
    func scan(packagePath: String): Int {
        return this.scanWhere(packagePath, { t ->
            t.isAnnotationPresent(Controller.Class)
        });
    }

    // v0.32：自定义谓词包扫描（嵌套子包）。谓词为 true 且 canNewInstance 才 register。
    // 例：scanWhere("corp/web", { t -> t.isAnnotationPresent(Controller.Class) })
    //     scanWhere("corp/service", { t -> t.implementsEnding("Plugin") })
    func scanWhere(packagePath: String, pred: Func<reflect.Class, Bool>): Int {
        var n = 0;
        val types = reflect.findTypesNested(packagePath, pred);
        var i = 0;
        while (i < types.length) {
            val t = types[i];
            if (t.canNewInstance()) {
                val o = t.newInstance();
                if (o != null) {
                    this.register(o!!);
                    n += 1;
                }
            }
            i += 1;
        }
        return n;
    }

    // 精确包（不含嵌套子包）+ 谓词
    func scanWhereExact(packagePath: String, pred: Func<reflect.Class, Bool>): Int {
        var n = 0;
        val types = reflect.findTypesExact(packagePath, pred);
        var i = 0;
        while (i < types.length) {
            val t = types[i];
            if (t.canNewInstance()) {
                val o = t.newInstance();
                if (o != null) {
                    this.register(o!!);
                    n += 1;
                }
            }
            i += 1;
        }
        return n;
    }

    // 多路径扫描（可重叠；同一控制器可能被重复 register）
    func scanPackages(paths: [String]): Int {
        var n = 0;
        var i = 0;
        while (i < paths.length) {
            n += this.scan(paths[i]);
            i += 1;
        }
        return n;
    }

    // v0.31：按类型表无参实例化并 register（失败返回 false）
    func registerNew(t: reflect.Class): Bool {
        if (!t.canNewInstance()) { return false; }
        val o = t.newInstance();
        if (o == null) { return false; }
        this.register(o!!);
        return true;
    }

    // v0.31：多参构造槽 + register（依赖注入：调用方准备 [Long] 槽）
    func registerNewArgs(t: reflect.Class, args: [Long]): Bool {
        if (!t.hasFactory()) { return false; }
        if (t.ctorParamCount() != args.length) { return false; }
        val o = t.newInstanceArgs(args);
        if (o == null) { return false; }
        this.register(o!!);
        return true;
    }

    func dispatch(req: HttpRequest): HttpResponse {
        // 静态文件（路由前；仅 GET）
        if (req.method == "GET") {
            val staticResp = this.tryStatic(req.path);
            if (staticResp != null) { return staticResp!!; }
        }
        // 拦截器 pre
        var ii = 0;
        while (ii < this.interceptors.length) {
            if (!this.interceptors[ii].preHandle(req)) {
                return HttpResponse.of(403, "forbidden");
            }
            ii += 1;
        }
        val chain = new FilterChain();
        chain.filters = this.filters;
        chain.index = 0;
        val term = chain.terminal;
        term.app = this;
        val resp = chain.proceed(req);
        // 拦截器 post
        var ji = 0;
        while (ji < this.interceptors.length) {
            this.interceptors[ji].postHandle(req, resp);
            ji += 1;
        }
        return resp;
    }

    func tryStatic(path: String): HttpResponse? {
        var mi = 0;
        while (mi < this.staticMounts.length) {
            val m = this.staticMounts[mi];
            mi += 1;
            val pref = m.prefix;
            var matched = false;
            var rel = "";
            if (path == pref) {
                matched = true;
                rel = "";
            } else if (pref == "/") {
                matched = true;
                if (String.valueOf(path).startsWith("/")) {
                    rel = String.valueOf(path).substring(1, path.length);
                } else {
                    rel = path;
                }
            } else if (String.valueOf(path).startsWith(pref + "/")) {
                matched = true;
                rel = String.valueOf(path).substring(pref.length + 1, path.length);
            }
            if (!matched) { continue; }
            if (!HttpApp.isSafeRelPath(rel)) {
                return HttpResponse.of(403, "forbidden");
            }
            var filePath = m.root;
            if (rel.length == 0) {
                filePath = os.Path.join(m.root, "index.html");
            } else {
                filePath = HttpApp.safeJoin(m.root, rel);
                if (filePath.length == 0) {
                    return HttpResponse.of(403, "forbidden");
                }
            }
            if (!os.exists(filePath)) {
                // 前缀命中但文件不存在 → 404（不落入其它路由）
                return HttpResponse.of(404, "not found");
            }
            return HttpResponse.file(filePath);
        }
        return null;
    }

    static func isSafeRelPath(rel: String): Bool {
        if (rel.length == 0) { return true; }
        if (String.valueOf(rel).indexOf("..") >= 0) { return false; }
        if (String.valueOf(rel).indexOf(":") >= 0) { return false; } // win 盘符
        if (String.valueOf(rel).startsWith("/") || String.valueOf(rel).startsWith("\\")) {
            return false;
        }
        return true;
    }

    static func safeJoin(root: String, rel: String): String {
        if (!HttpApp.isSafeRelPath(rel)) { return ""; }
        var cur = root;
        val parts = text.split(rel, "/");
        var i = 0;
        while (i < parts.length) {
            val p = parts[i];
            i += 1;
            if (p.length == 0 || p == ".") { continue; }
            if (p == "..") { return ""; }
            cur = os.Path.join(cur, p);
        }
        return cur;
    }

    // v0.49 / v0.55.22：控制器结果 → HttpResponse（引用走 invokeObj，对标 Java Method.invoke→Object）
    static func coerceResultObj(retType: String, o: Object?): HttpResponse {
        if (o == null) {
            if (retType == "Unit" || retType == "void") {
                return HttpResponse.of(204, "");
            }
            if (String.valueOf(retType).indexOf("HttpResponse") >= 0) {
                return HttpResponse.of(500, "null response");
            }
            return HttpResponse.json(200, "null");
        }
        val v = o!!;
        if (retType.length == 0) {
            if (v is HttpResponse) { return v as HttpResponse; }
            return HttpResponse.json(v);
        }
        if (String.valueOf(retType).indexOf("HttpResponse") >= 0) {
            return v as HttpResponse;
        }
        return HttpResponse.json(v);
    }

    func invokeRoute(req: HttpRequest): HttpResponse {
        val key = HttpApp.routeKey(req.method, req.path);
        val b = this.routes.get(key);
        if (b == null) {
            return HttpResponse.of(404, "not found: " + key);
        }
        val bind = b!!;
        if (bind.hasFn) {
            val fn = bind.fn;
            return fn(req);
        }
        if (bind.ctrl == null) {
            return HttpResponse.of(500, "empty route");
        }
        val ctrl = bind.ctrl!!;
        val t = reflect.typeOf(ctrl);
        var args: [Long] = [];
        args += reflect.ptrOf(req);
        val retType = t.methodReturnType(bind.methodName);
        if (retType == "Unit" || retType == "void") {
            t.invokeUnit(ctrl, bind.methodName, args);
            return HttpResponse.of(204, "");
        }
        if (retType == "String" || retType == "String?") {
            val s = t.invokeStr(ctrl, bind.methodName, args);
            if (s == null) { return HttpResponse.text(""); }
            return HttpResponse.text(s!!);
        }
        // 引用 / Bean / HttpResponse：invokeObj（禁止 Long 藏指针）
        val o = t.invokeObj(ctrl, bind.methodName, args);
        return HttpApp.coerceResultObj(retType, o);
    }

    // v0.50 keep-alive；v0.50.3 ByteBuf 粘包 + Pipeline
    func serveOnce(): Bool {
        val client = this.server.accept();
        if (client == null) { return false; }
        return this.serveConnection(client!!);
    }

    func serveConnection(client: Socket): Bool {
        val ch = new Channel(client);
        ch.pipeline.addLast(new HttpAppDispatchHandler(this));
        return this.serveChannel(ch);
    }

    func serveChannel(ch: Channel): Bool {
        ch.sock.setTimeout(5000);
        var handled = false;
        while (true) {
            val raw = Http.readOneMessage(ch.sock, ch.inbound, false);
            if (raw.length == 0) { break; }
            val req = HttpServer.parseRequest(raw);
            var keep = true;
            val conn = req.getHeader("Connection");
            if (conn != null && String.valueOf(conn!!).toLowerCase() == "close") {
                keep = false;
            }
            val out = ch.pipeline.fireChannelRead(req);
            if (out == null || !(out is HttpResponse)) { break; }
            /* /api/* 压测常 keep-alive 占满 worker；默认短连接，避免 4 worker 被挂死连接钉死 */
            var useKeep = keep;
            if (String.valueOf(req.path).startsWith("/api/")) { useKeep = false; }
            HttpServer.writeResponse(ch.sock, out as HttpResponse, useKeep);
            handled = true;
            if (!useKeep) { break; }
        }
        ch.close();
        return handled;
    }

    // 循环 accept；调用 close() 或外部停机后结束
    func serve() {
        this.running = true;
        while (this.running) {
            if (!this.serveOnce()) {
                if (!this.running) { break; }
            }
        }
    }

    // 多线程抢 accept（旧模型）；新代码请用 serveBossWorkers
    func serveParallel(workers: Int) {
        this.running = true;
        var n = workers;
        if (n < 1) { n = 1; }
        var i = 1;
        while (i < n) {
            val app = this;
            val th = new thread.Thread();
            th.start({
                while (app.running) {
                    if (!app.serveOnce()) {
                        if (!app.running) { break; }
                    }
                }
            });
            i += 1;
        }
        while (this.running) {
            if (!this.serveOnce()) {
                if (!this.running) { break; }
            }
        }
    }

    // v0.50.3：Netty OIO —— boss 只 accept，EventLoopGroup worker 处理连接
    func serveBossWorkers(workers: Int) {
        this.running = true;
        var n = workers;
        if (n < 1) { n = 1; }
        val group = new EventLoopGroup(n);
        while (this.running) {
            val client = this.server.accept();
            if (client == null) {
                if (!this.running) { break; }
                continue;
            }
            val c = client!!;
            val app = this;
            val ok = group.submit({
                app.serveConnection(c);
            });
            if (!ok) {
                this.serveConnection(c);
            }
        }
        group.shutdown();
    }

    static func routeKey(method: String, path: String): String {
        return method + " " + path;
    }

    static func joinPath(base: String, path: String): String {
        if (base.length == 0) {
            if (path.length == 0) { return "/"; }
            if (String.valueOf(path).startsWith("/")) { return path; }
            return "/" + path;
        }
        var b = base;
        if (!String.valueOf(b).startsWith("/")) { b = "/" + b; }
        if (String.valueOf(b).endsWith("/")) {
            b = String.valueOf(b).substring(0, b.length - 1);
        }
        if (path.length == 0) { return b; }
        if (String.valueOf(path).startsWith("/")) { return b + path; }
        return b + "/" + path;
    }

    static func annoPath(v: String): String {
        if (v.length == 0) { return ""; }
        val pfx = "path=";
        val i = String.valueOf(v).indexOf(pfx);
        if (i >= 0) {
            var s = i + pfx.length;
            var e = s;
            while (e < v.length && String.valueOf(v).charAt(e) != 59) { e += 1; }
            return String.valueOf(v).substring(s, e);
        }
        val vpfx = "value=";
        val vi = String.valueOf(v).indexOf(vpfx);
        if (vi >= 0) {
            var s2 = vi + vpfx.length;
            var e2 = s2;
            while (e2 < v.length && String.valueOf(v).charAt(e2) != 59) { e2 += 1; }
            return String.valueOf(v).substring(s2, e2);
        }
        val sc = String.valueOf(v).indexOf(";");
        if (sc >= 0) { return String.valueOf(v).substring(0, sc); }
        return v;
    }

    static func annoMethod(v: String): String {
        val pfx = "method=";
        val i = String.valueOf(v).indexOf(pfx);
        if (i < 0) { return ""; }
        var s = i + pfx.length;
        var e = s;
        while (e < v.length && String.valueOf(v).charAt(e) != 59) { e += 1; }
        return String.valueOf(v).substring(s, e);
    }
}

// Pipeline 末环：把 HttpRequest 交给 HttpApp.dispatch（须在 HttpApp 之后定义）
public class HttpAppDispatchHandler extends ChannelHandler {
    var app: HttpApp?;

    constructor(app: HttpApp) {
        this.app = app;
    }

    override func channelRead(ctx: ChannelHandlerContext, msg: Object): Object? {
        if (this.app == null) { return null; }
        if (!(msg is HttpRequest)) { return null; }
        return this.app!!.dispatch(msg as HttpRequest);
    }
}
