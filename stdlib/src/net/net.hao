// HaoLang 标准库 —— net 网络库
// 句柄：NativeHandle 代理 OS socket（C 拥有；Handle 代理释放一次）。
//
// 读契约（对齐 Go net.Conn / Java InputStream，v0.49.4）：
//   recv: n>0 → 数据；n==0 → ""（EOF）；n<0 → null（超时/错误）
//   send: 写满循环（对标完整写）；失败 -1
package net;

import lang;

public class Socket {
    var fd: NativeHandle;
    public constructor() { this.fd = NativeHandle.empty(); }
    public func connect(host: String, port: Int): Bool { return _connect(this.fd, host, port); }
    public func send(data: String): Int { return _send(this.fd, data); }

    // 一次 OS recv。"" = EOF；null = 超时/错误。C 填 [Byte]，Hao fromUtf8。
    public func recv(maxLen: Int): String? {
        val bytes = _recvBytes(this.fd, maxLen);
        if (bytes == null) { return null; }
        return String.fromUtf8Owned(bytes!!);
    }

    // 对标 Go io.ReadFull / Java readNBytes：凑满 n 字节，否则 null。
    public func recvExact(n: Int): String? {
        if (n < 0) { return null; }
        if (n == 0) { return ""; }
        val sb = lang.StringBuilder.withCapacity(n);
        while (sb.byteLength() < n) {
            val need = n - sb.byteLength();
            var want = need;
            if (want > 65536) { want = 65536; }
            val chunk = this.recv(want);
            if (chunk == null) { return null; }
            if (_netByteLen(chunk!!) == 0) { return null; }
            sb.append(chunk!!);
        }
        return sb.toString();
    }

    public func setReadTimeout(ms: Int): Bool { return _setRecvTimeout(this.fd, ms); }
    public func setWriteTimeout(ms: Int): Bool { return _setSendTimeout(this.fd, ms); }
    public func setTimeout(ms: Int): Bool { return _setTimeout(this.fd, ms); }
    public func close(): Unit { _close(this.fd); }
}

public class ServerSocket {
    var fd: NativeHandle;
    public constructor() { this.fd = NativeHandle.empty(); }
    public func listen(port: Int): Bool { return _listen(this.fd, port); }
    public func listenBacklog(port: Int, backlog: Int): Bool {
        return _listenBacklog(this.fd, port, backlog);
    }

    // 出参形式（v0.50 起实例方法可按参数重载）
    public func accept(client: Socket): Bool { return _accept(this.fd, client.fd); }

    // 对标 Go Accept / Java accept：失败 null
    public func accept(): Socket? {
        val client = new Socket();
        if (!this.accept(client)) { return null; }
        return client;
    }

    public func setReadTimeout(ms: Int): Bool { return _setRecvTimeout(this.fd, ms); }
    public func setWriteTimeout(ms: Int): Bool { return _setSendTimeout(this.fd, ms); }
    public func setTimeout(ms: Int): Bool { return _setTimeout(this.fd, ms); }
    public func close(): Unit { _close(this.fd); }
}

public class UdpSocket {
    var fd: NativeHandle;
    public constructor() { this.fd = NativeHandle.empty(); }
    public func open(): Bool { return _udp_open(this.fd); }
    public func bind(port: Int): Bool { return _udp_bind(this.fd, port); }
    public func sendTo(host: String, port: Int, data: String): Int {
        return _udp_sendto(this.fd, host, port, data);
    }
    public func recvFrom(maxLen: Int): String? {
        val bytes = _udp_recvfrom_bytes(this.fd, maxLen);
        if (bytes == null) { return null; }
        return String.fromUtf8Owned(bytes!!);
    }
    public func close(): Unit { _close(this.fd); }
}

extern func _connect(p: NativeHandle, host: String, port: Int): Bool = "hao_net_connect";
extern func _send(p: NativeHandle, data: String): Int = "hao_net_send";
extern func _recvBytes(p: NativeHandle, max: Int): [Byte]? = "hao_net_recv_bytes";
extern func _close(p: NativeHandle): Unit = "hao_net_close";
extern func _listen(p: NativeHandle, port: Int): Bool = "hao_net_listen";
extern func _listenBacklog(p: NativeHandle, port: Int, backlog: Int): Bool = "hao_net_listen_backlog";
extern func _setTimeout(p: NativeHandle, ms: Int): Bool = "hao_net_set_timeout";
extern func _setRecvTimeout(p: NativeHandle, ms: Int): Bool = "hao_net_set_recv_timeout";
extern func _setSendTimeout(p: NativeHandle, ms: Int): Bool = "hao_net_set_send_timeout";
extern func _accept(s: NativeHandle, c: NativeHandle): Bool = "hao_net_accept";
extern func _udp_open(p: NativeHandle): Bool = "hao_net_udp_open";
extern func _udp_bind(p: NativeHandle, port: Int): Bool = "hao_net_udp_bind";
extern func _udp_sendto(p: NativeHandle, host: String, port: Int, data: String): Int = "hao_net_udp_sendto";
extern func _udp_recvfrom_bytes(p: NativeHandle, max: Int): [Byte]? = "hao_net_udp_recvfrom_bytes";

func _netByteLen(s: String): Int { return String.utf8ByteLen(s); }
