package hash;

// float/double 位模式哈希仍走 C（无 Hao 浮点 bitcast）
extern func hao_hash_float(x: Double): Int = "hao_hash_float";
extern func hao_hash_f32(x: Float): Int = "hao_hash_f32";

// splitmix64 风格混合（v0.56：上移 Hao）
func mix64(x: Long): Long {
    var v = x;
    v = v ^ (v >> 30);
    v = v * -1085102592571150091; // 0xbf58476d1ce4e5b9
    v = v ^ (v >> 27);
    v = v * -7723592293116104311; // 0x94d049bb133111eb
    v = v ^ (v >> 31);
    return v;
}

func mixToInt(x: Long): Int {
    val m = mix64(x);
    val i: Int = m;
    return i;
}

func hashOf(x: Int): Int {
    val xl: Long = x;
    return mixToInt(xl);
}
func hashOf(x: UInt): Int {
    val xi: Int = x;
    return hashOf(xi);
}
func hashOf(x: Long): Int {
    return mixToInt(x);
}
func hashOf(x: ULong): Int {
    val xl: Long = x;
    return mixToInt(xl);
}
func hashOf(x: Float): Int { return hao_hash_f32(x); }
func hashOf(x: Double): Int { return hao_hash_float(x); }
func hashOf(x: Bool): Int {
    if (x) { return 1231; }
    return 1237;
}
func hashOf(x: Char): Int {
    val xi: Int = x;
    return hashOf(xi);
}
func hashOf(x: String): Int {
    val bytes = hao_str_get_bytes(x);
    var h: Long = -3750763034362895579; // FNV offset basis
    var i = 0;
    while (i < bytes.length) {
        val b: Int = bytes[i];
        h = h ^ b;
        h = h * 1099511628211;
        i = i + 1;
    }
    val out: Int = h;
    return out;
}
func hashOf(x: Object): Int { return x.hashCode(); }
func hashOf(x: Byte): Int {
    val xi: Int = x;
    return hashOf(xi);
}
func hashOf(x: SByte): Int {
    val xi: Int = x;
    return hashOf(xi);
}
func hashOf(x: Short): Int {
    val xi: Int = x;
    return hashOf(xi);
}
func hashOf(x: UShort): Int {
    val xi: Int = x;
    return hashOf(xi);
}

func equalsKey(a: Int, b: Int): Bool { return a == b; }
func equalsKey(a: UInt, b: UInt): Bool { return a == b; }
func equalsKey(a: Long, b: Long): Bool { return a == b; }
func equalsKey(a: ULong, b: ULong): Bool { return a == b; }
func equalsKey(a: Float, b: Float): Bool { return a == b; }
func equalsKey(a: Double, b: Double): Bool { return a == b; }
func equalsKey(a: Bool, b: Bool): Bool { return a == b; }
func equalsKey(a: Char, b: Char): Bool { return a == b; }
func equalsKey(a: String, b: String): Bool { return a == b; }
func equalsKey(a: Object, b: Object): Bool { return a.equals(b); }
func equalsKey(a: Byte, b: Byte): Bool { return a == b; }
func equalsKey(a: SByte, b: SByte): Bool { return a == b; }
func equalsKey(a: Short, b: Short): Bool { return a == b; }
func equalsKey(a: UShort, b: UShort): Bool { return a == b; }
