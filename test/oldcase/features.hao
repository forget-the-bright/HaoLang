package main;

// 函数：参数、返回值、递归
func add(a: Int, b: Int): Int {
    return a + b;
}

func fib(n: Int): Int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func greet(name: String): String {
    return $"你好, {name}!";
}

func half(x: Int): Double {
    return x / 2.0;
}

func main() {
    // ---------- 变量与类型推断 ----------
    val name = "HaoLang";
    var count = 3;
    val pi = 3.14;
    val yes = true;

    fmt.println(name);
    fmt.println(count);
    fmt.println(pi);
    fmt.println(yes);

    // ---------- 显式类型标注 ----------
    val n: Int = 42;
    val d: Double = 2.5;
    fmt.println(n);
    fmt.println(d);

    // ---------- 整数算术 ----------
    fmt.println(1 + 2 * 3);          // 7
    fmt.println((1 + 2) * 3);        // 9
    fmt.println(17 / 5);             // 3
    fmt.println(17 % 5);             // 2
    fmt.println(-count);             // -3

    // ---------- 浮点与类型提升 ----------
    fmt.println(1.5 + 2.5);          // 4
    fmt.println(count + 0.5);        // 3.5  (Int -> Double)
    fmt.println(10 / 4.0);           // 2.5

    // ---------- 字符串 ----------
    fmt.println("a" + "b" + "c");
    fmt.println("count = " + count);
    fmt.println(name.length);        // 7

    // ---------- 模板字符串 ----------
    fmt.println($"名称={name}, 数量={count}");
    fmt.println($"计算: {count} * 2 = {count * 2}");
    fmt.println($"嵌套: {add(1, 2)}");

    // ---------- 比较与逻辑 ----------
    fmt.println(count > 2);
    fmt.println(count == 3);
    fmt.println(name == "HaoLang");
    fmt.println(count > 1 && count < 10);
    fmt.println(count > 100 || count == 3);
    fmt.println(!yes);

    // ---------- 赋值与复合赋值 ----------
    count = 10;
    fmt.println(count);
    count += 5;
    fmt.println(count);              // 15
    count -= 3;
    fmt.println(count);              // 12
    count *= 2;
    fmt.println(count);              // 24
    count /= 4;
    fmt.println(count);              // 6

    // ---------- if / else ----------
    if (count > 5) {
        fmt.println("count 大于 5");
    } else {
        fmt.println("count 不大于 5");
    }

    // ---------- while 循环 ----------
    var i = 0;
    while (i < 3) {
        fmt.println($"i = {i}");
        i += 1;
    }

    // ---------- 嵌套循环 ----------
    var r = 0;
    var sum = 0;
    while (r < 3) {
        var c = 0;
        while (c < 3) {
            sum += r * c;
            c += 1;
        }
        r += 1;
    }
    fmt.println($"sum = {sum}");     // 9

    // ---------- 函数调用 ----------
    fmt.println(add(3, 4));          // 7
    fmt.println(greet("世界"));
    fmt.println(fib(10));            // 55
    fmt.println(half(7));            // 3.5

    // ---------- 作用域遮蔽 ----------
    val x = 1;
    if (true) {
        val x = 2;
        fmt.println(x);              // 2
    }
    fmt.println(x);                  // 1
}
