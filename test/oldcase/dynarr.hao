package main;

import collections;

class Item {
    var tag: Int = 0;
    constructor(tag: Int) { this.tag = tag; }
    func label(): String { return $"item{this.tag}"; }
}

func main() {
    // 1. ArrayList + add
    var xs = new collections.ArrayList<Int>();
    xs.add(10);
    xs.add(20);
    xs.add(30);
    fmt.println(xs.size());      // 3
    fmt.println(xs.get(0));      // 10
    fmt.println(xs.get(2));      // 30

    // 2. 触发内部 ensureCapacity 扩容
    var i = 0;
    while (i < 10) {
        xs.add(i * 100);
        i += 1;
    }
    fmt.println(xs.size());      // 13
    fmt.println(xs.get(12));     // 900
    fmt.println(xs.get(3));      // 0 (第一个 i=0)

    // 3. 字符串 ArrayList
    var names = new collections.ArrayList<String>();
    names.add("alpha");
    names.add("beta");
    names.add("gamma");
    fmt.println(names.size());   // 3
    fmt.println(names.get(1));   // beta

    // 4. 先装入再追加
    var ds = new collections.ArrayList<Double>();
    ds.add(1.5);
    ds.add(2.5);
    ds.add(3.5);
    fmt.println(ds.size());      // 3
    fmt.println(ds.get(2));      // 3.5

    // 5. add 对象引用
    var items = new collections.ArrayList<Item>();
    var k = 0;
    while (k < 5) {
        items.add(new Item(k));
        k += 1;
    }
    fmt.println(items.size());   // 5
    fmt.println(items.get(4).label()); // item4

    // 6. for-in 遍历 ArrayList
    var total = 0;
    for (x in xs) {
        total += x;
    }
    fmt.println(total);          // 10+20+30 + (0+100+...+900) = 60 + 4500 = 4560

    // 7. removeAt(size-1)：移除并返回末尾元素
    fmt.println(xs.removeAt(xs.size() - 1));       // 900
    fmt.println(xs.removeAt(xs.size() - 1));       // 800
    fmt.println(xs.size());                        // 11
    fmt.println(names.removeAt(names.size() - 1)); // gamma
    fmt.println(items.removeAt(items.size() - 1).label()); // item4
}
