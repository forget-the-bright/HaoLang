package main;
import collections;

func main() {
    val s = new collections.Stack<Int>();
    fmt.println(s.isEmpty());      // true
    s.push(10); s.push(20); s.push(30);
    fmt.println(s.size());         // 3
    fmt.println(s.peek() ?? -1);   // 30（不弹出）
    fmt.println(s.size());         // 3
    fmt.println(s.pop() ?? -1);    // 30
    fmt.println(s.pop() ?? -1);    // 20
    fmt.println(s.pop() ?? -1);    // 10
    fmt.println(s.pop() ?? -1);    // -1（空栈）
    fmt.println(s.isEmpty());      // true
}