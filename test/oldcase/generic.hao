package main;

// ---- 单类型参数 ----
class Box<T> {
    var value: T;
    constructor(v: T) { this.value = v; }
    func get(): T { return this.value; }
    func set(v: T) { this.value = v; }
    func isSame(other: T): Bool {
        return this.value == other;
    }
}

// ---- 多类型参数 ----
class Pair<K, V> {
    var key: K;
    var value: V;
    constructor(k: K, v: V) { this.key = k; this.value = v; }
    func getKey(): K { return this.key; }
    func getValue(): V { return this.value; }
    func swap(): Pair<V, K> {
        return new Pair<V, K>(this.value, this.key);
    }
}

// ---- 泛型与数组 ----
class Holder<T> {
    var items: [T];
    constructor(a: [T]) { this.items = a; }
    func first(): T { return this.items[0]; }
    func last(): T { return this.items[this.items.length - 1]; }
    func size(): Int { return this.items.length; }
}

// ---- 泛型与接口 ----
interface Speaker {
    func speak(): String;
}

class Person : Speaker {
    var name: String = "";
    constructor(n: String) { this.name = n; }
    override func speak(): String {
        return "我是 " + this.name;
    }
}

// ---- 泛型函数 ----
// 类型参数由实参数组推断，无需在调用处显式写 <T>
func firstOf<T>(a: [T]): T {
    return a[0];
}

// 数组目前是固定大小；这里用预分配的 [T; times] 形式初始化后填充。
// 为兼容当前语法，用 count 累加验证 T 的传递：
func countIf<T>(values: [T], target: T): Int {
    var n = 0;
    var i = 0;
    while (i < values.length) {
        if (values[i] == target) {
            n += 1;
        }
        i += 1;
    }
    return n;
}

func main() {
    // ---- 基本单态化 ----
    val bi = new Box<Int>(42);
    fmt.println(bi.get());           // 42
    val bs = new Box<String>("你好");
    fmt.println(bs.get());           // 你好
    bi.set(99);
    fmt.println(bi.get());           // 99
    fmt.println(bi.isSame(99));      // true

    // ---- 多类型参数 ----
    val p = new Pair<String, Int>("年龄", 30);
    fmt.println(p.getKey());         // 年龄
    fmt.println(p.getValue());       // 30

    // ---- 泛型实例作字段类型与返回值 ----
    val swapped = p.swap();
    fmt.println(swapped.getKey());   // 30
    fmt.println(swapped.getValue()); // 年龄

    // ---- 泛型 + 数组 ----
    val h = new Holder<Int>(new [Int]{ 10, 20, 30 });
    fmt.println(h.first());          // 10
    fmt.println(h.last());           // 30
    fmt.println(h.size());           // 3

    val hs = new Holder<String>(new [String]{ "甲", "乙", "丙" });
    fmt.println(hs.last());          // 丙

    // ---- 链式调用 ----
    fmt.println(new Box<Int>(7).get());  // 7
    val p2 = new Pair<String, Int>("x", 1);
    fmt.println(p2.swap().getKey());    // 1

    // ---- 嵌套泛型 Box<Box<Int>> ----
    val nested = new Box<Box<Int>>(new Box<Int>(5));
    fmt.println(nested.get().get());    // 5

    // ---- 各值类型 ----
    val bd = new Box<Double>(3.5);
    fmt.println(bd.get());             // 3.5
    val bb = new Box<Bool>(true);
    fmt.println(bb.get());             // true

    // ---- 泛型函数（T 由实参推断）----
    fmt.println(firstOf(new [Int]{ 7, 8, 9 }));     // 7
    fmt.println(firstOf(new [String]{ "a", "b" }));     // a
    fmt.println(countIf(new [Int]{ 1, 2, 1, 3, 1 }, 1));  // 3

    // ---- 泛型 + 接口（动态分派）----
    val person = new Person("爱丽丝");
    fmt.println(person.speak());             // 我是 爱丽丝
}
