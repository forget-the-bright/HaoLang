// ============================================================
//  v0.32：可扩展包扫描 + 复杂多包夹具 corp.*（可复用）
//  验证：嵌套/精确路径、注解条件、接口条件、自定义谓词、隐患
// ============================================================
package main;

import corp.marker;
import corp.service.core;
import corp.service.api;
import corp.web.ctrl;
import corp.web.admin;
import corp.skip;
import net;
import reflect;
import thread;

func pkgScanTest() {
    // ---- 嵌套 vs 精确：corp/service 含 core + api；exact 不含 ----
    val allSvc = reflect.findTypesNested("corp/service", { t -> true });
    var hasCore = false;
    var hasApi = false;
    var i = 0;
    while (i < allSvc.length) {
        val pp = allSvc[i].packagePath();
        if (pp == "corp/service/core") { hasCore = true; }
        if (pp == "corp/service/api") { hasApi = true; }
        i += 1;
    }
    fmt.println(hasCore);                                 // true
    fmt.println(hasApi);                                  // true

    val exactCore = reflect.findTypesExact("corp/service/core", { t -> true });
    fmt.println(exactCore.length >= 1);                   // true
    val exactSvcRoot = reflect.findTypesExact("corp/service", { t -> true });
    fmt.println(exactSvcRoot.length == 0);                // true（无直接落在 corp/service 的类）

    // ---- 注解条件：@Service ----
    val services = reflect.findTypesNested("corp/service", { t ->
        t.isAnnotationPresent(marker.Service.Class)
    });
    fmt.println(services.length >= 2);                    // true

    // ---- 接口条件：Plugin ----
    val plugins = reflect.findTypesNested("corp", { t ->
        t.implementsEnding("Plugin")
    });
    fmt.println(plugins.length >= 1);                     // true
    var pluginSvc = false;
    if (plugins.length > 0) {
        pluginSvc = plugins[0].isAnnotationPresent(marker.Service.Class);
    }
    fmt.println(pluginSvc);                               // true

    // ---- 组合谓词：Service 且可无参 new ----
    val newable = reflect.findTypesNested("corp/service", { t ->
        t.isAnnotationPresent(marker.Service.Class) && t.canNewInstance()
    });
    fmt.println(newable.length >= 2);                     // true

    // ---- 排除无注解：corp/skip 有类，但 Service 谓词为空 ----
    val skipSvc = reflect.findTypesNested("corp/skip", { t ->
        t.isAnnotationPresent(marker.Service.Class)
    });
    fmt.println(skipSvc.length == 0);                     // true
    val skipAll = reflect.findTypesNested("corp/skip", { t -> true });
    fmt.println(skipAll.length >= 1);                     // true

    // ---- 路径规范化 ----
    fmt.println(reflect.normalizePackagePath("corp.web.ctrl") == "corp/web/ctrl"); // true
    fmt.println(reflect.normalizePackagePrefix("corp/web") == "corp$web$"); // true

    // ---- MVC scanWhere：按注解扫 web；exact 只扫 ctrl ----
    val app = new net.HttpApp();
    if (!app.listen(7904)) {
        fmt.println("pkgscan-listen-fail");
        return;
    }
    val nWeb = app.scanWhere("corp/web", { t -> t.isAnnotationPresent(net.Controller.Class) });
    fmt.println(nWeb >= 2);                               // true（ctrl + admin）

    val app2 = new net.HttpApp();
    val nExact = app2.scanWhereExact("corp/web/ctrl", { t ->
        t.isAnnotationPresent(net.Controller.Class)
    });
    fmt.println(nExact >= 1);                             // true
    val nExactAdminMiss = app2.scanWhereExact("corp/web", { t ->
        t.isAnnotationPresent(net.Controller.Class)
    });
    fmt.println(nExactAdminMiss == 0);                    // true（web 本身无类）

    val th = new thread.Thread();
    th.start({ app.serveOnce(); });
    thread.sleep(80);
    val r1 = net.Http.get("http://127.0.0.1:7904/corp/home");
    fmt.println(r1.body);                                 // corp-home
    th.join();

    val th2 = new thread.Thread();
    th2.start({ app.serveOnce(); });
    thread.sleep(80);
    val r2 = net.Http.get("http://127.0.0.1:7904/corp/admin/ping");
    fmt.println(r2.body);                                 // corp-admin
    th2.join();

    app.close();
}
