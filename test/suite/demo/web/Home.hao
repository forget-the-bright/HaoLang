package demo.web;

import net.*;

@Controller
@RequestMapping(path = "/web")
class HomeController {
    @GetMapping(path = "/home")
    func home(req: HttpRequest): HttpResponse {
        return HttpResponse.of(200, "web-home");
    }
}
