// ============================================================
//  多文件测试套件 · extern：extern C 函数声明
//  覆盖：extern_fn
// ============================================================
package main;

// extern 函数：声明外部 C 函数（运行时/系统库），无函数体。
// = "hao_println_str" 指定 LLVM IR 中的 C 符号名；省略则用函数短名。
// P7a 已删标量 hao_println_*；extern 测链到仍存在的 _str。
extern func extPrintStr(s: String) = "hao_println_str";

func externTest() {
    extPrintStr(Integer.toStr(42));                 // 42
    extPrintStr("hello extern");
    // 语言 API：码点长度（禁再冒烟死符号 hao_str_len）
    extPrintStr(Integer.toStr("HaoLang".length));   // 7
}
