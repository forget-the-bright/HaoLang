// ============================================================
//  多文件测试套件 · object：Object 根 / hashCode / equals / toString
//  覆盖：object_root
// ============================================================
package main;

import object;
import collections;
import hash;

// 不显式继承，默认继承 Object；覆写三个方法
class ObjPerson {
    var name: String;
    constructor(n: String) { this.name = n; }
    override func hashCode(): Int { return hash.hashOf(this.name); }
    override func equals(o: Object): Bool {
        val other = o as ObjPerson;
        return this.name == other.name;
    }
    override func toString(): String { return "Person(" + this.name + ")"; }
}

func objectTest() {
    // 1. Object 类型可接收任意对象，is/as 运行时判定
    var o: Object = new ObjPerson("bob");
    fmt.println(o is ObjPerson);          // true

    // 2. 多态：经 Object 引用调覆写后的 equals（内容相等）
    val p1 = new ObjPerson("alice");
    fmt.println(p1.equals(new ObjPerson("alice")));   // true
    fmt.println(p1.equals(new ObjPerson("bob")));     // false

    // 3. 默认身份语义：不覆写 equals 的两个不同对象不相等
    val q1 = new ObjPerson("x");
    val q2 = new ObjPerson("x");
    fmt.println(q1.equals(p1));   // false

    // 4. toString 覆写生效
    fmt.println(p1.toString());    // Person(alice)

    // 5. hashCode：内容相等对象哈希一致
    val p2 = new ObjPerson("alice");
    fmt.println(p1.hashCode() == p2.hashCode());   // true

    // 6. v0.50.1：TypeName.Class / getClass 单例身份
    fmt.println(ObjPerson.Class == p1.getClass()); // true
    fmt.println(ObjPerson.Class == ObjPerson.Class); // true
    fmt.println(ObjPerson.Class.getName().length > 0); // true
}