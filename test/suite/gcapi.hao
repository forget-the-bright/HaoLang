// ============================================================
//  多文件测试套件 · gc API（v0.34）
//  手动 collect + 统计字段可读（轻量，非 oldcase 压力测）
// ============================================================
package main;

import gc;
import os;

class GcProbe {
    var n: Int = 0;
    constructor(n: Int) { this.n = n; }
}

func gcApiTest() {
    // 先读统计（不强制 collect，避免与后续套件时序竞态）
    val thr = gc.GC.threshold();
    fmt.println(thr > 0);                      // true
    fmt.println(gc.GC.blockCount() >= 0);      // true
    fmt.println(gc.GC.liveBytes() >= 0);       // true
    fmt.println(gc.GC.allocatedSinceGc() >= 0); // true
    fmt.println(gc.GC.finalizerRuns() >= 0);   // true
    fmt.println(gc.GC.finalizerSets() >= 0);   // true

    val before = gc.GC.collectCount();
    // 少量分配后手动 collect
    var i = 0;
    while (i < 50) {
        val p = new GcProbe(i);
        i += 1;
        if (p.n < 0) { i = i; } // 防优化掉 p（保持存活到循环末）
    }
    gc.GC.collect();
    val after = gc.GC.collectCount();
    fmt.println(after > before);               // true

    val s = gc.GC.summary();
    fmt.println(s.length > 10);                // true

    // v0.49.1：minor/major + 进程资源（对标 .NET Process）
    fmt.println(gc.GC.minorCount() >= 0);      // true
    fmt.println(gc.GC.majorCount() >= 1);      // true（刚手动 major）
    fmt.println(gc.GC.registeredThreads() >= 1); // true
    // v0.50.4：STW incomplete 可查；全标活已废除
    fmt.println(gc.GC.stwIncomplete() >= 0);   // true
    fmt.println(gc.GC.stwMarkAllFallbacks() == 0); // true
    // v0.51/0.52：并发标记至少一轮；堆字节可读
    fmt.println(gc.GC.concurrentMarkCycles() >= 1); // true
    fmt.println(gc.GC.heapBytes() >= 0);           // true
    fmt.println(gc.GC.markAssistSteps() >= 0);     // true
    fmt.println(os.Process.workingSetBytes() > 0); // true
    fmt.println(os.Process.handleCount() > 0); // true
    fmt.println(os.Process.threadCount() >= 1); // true
    fmt.println(os.Process.uptimeMs() >= 0);   // true
}
