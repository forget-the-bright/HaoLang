// ============================================================
//  多文件测试套件 · classes：类 / 字段 / 构造 / 方法 / 对象数组
//  覆盖：classes
// ============================================================
package main;

class CPoint {
    var x: Int = 0;
    var y: Int = 0;
    constructor(x: Int, y: Int) {
        this.x = x;
        this.y = y;
    }
    func describe(): String {
        return $"Point({this.x}, {this.y})";
    }
    func sum(): Int {
        return this.x + this.y;
    }
    func move(dx: Int, dy: Int) {
        this.x += dx;
        this.y += dy;
    }
    func scale(k: Int): CPoint {
        return new CPoint(this.x * k, this.y * k);
    }
}

class CCounter {
    var n: Int = 100;          // 字段默认值
    func inc() { this.n += 1; }
    func get(): Int { return this.n; }
}

// v0.33：同包可访问 internal 成员（跨包拒绝见 negcheck）
class CInternalBox {
    internal var secret: Int = 7;
    constructor() {}
    internal func peek(): Int { return this.secret; }
}

class CPerson {
    var name: String = "";
    var age: Int = 0;
    var score: Double = 0.0;
    constructor(name: String, age: Int) {
        this.name = name;
        this.age = age;
    }
    func greet(): String {
        return $"我是 {this.name}，{this.age} 岁";
    }
    func isAdult(): Bool {
        return this.age >= 18;
    }
}

class CBox {                   // 无构造函数
    var value: Int = 42;
    func get(): Int { return this.value; }
}

// v0.50：实例方法按参数签名重载
class COverload {
    func add(a: Int): Int { return a + 1; }
    func add(a: Int, b: Int): Int { return a + b; }
}

func shiftPoint(pt: CPoint): CPoint {
    return new CPoint(pt.x + 1, pt.y + 1);
}

func classesTest() {
    // ---------- 构造与方法调用 ----------
    val p = new CPoint(3, 4);
    fmt.println(p.describe());       // Point(3, 4)
    fmt.println(p.sum());            // 7

    // ---------- 字段直接读取 / 赋值 ----------
    fmt.println(p.x);                // 3
    p.x = 10;
    fmt.println(p.x);                // 10
    fmt.println(p.sum());            // 14

    // ---------- 方法修改状态 ----------
    val q = new CPoint(1, 1);
    q.move(2, 3);
    fmt.println(q.describe());       // Point(3, 4)

    // ---------- 方法返回对象 ----------
    val r = q.scale(10);
    fmt.println(r.describe());       // Point(30, 40)

    // ---------- 字段默认值 ----------
    val c = new CCounter();
    fmt.println(c.get());            // 100
    c.inc();
    c.inc();
    fmt.println(c.get());            // 102

    // ---------- 无构造函数 ----------
    val b = new CBox();
    fmt.println(b.get());            // 42

    // ---------- 多字段与不同类型 ----------
    val alice = new CPerson("爱丽丝", 20);
    fmt.println(alice.greet());
    fmt.println(alice.isAdult());    // true
    alice.score = 95.5;
    fmt.println(alice.score);        // 95.5

    val kid = new CPerson("小明", 10);
    fmt.println(kid.greet());
    fmt.println(kid.isAdult());      // false

    // ---------- 对象数组 ----------
    val pts = new [CPoint]{ new CPoint(1, 1), new CPoint(2, 2), new CPoint(3, 3) };
    fmt.println(pts.length);         // 3
    for (pt in pts) {
        fmt.println(pt.sum());       // 2, 4, 6
    }

    // ---------- 对象作为参数与返回值 ----------
    val moved = shiftPoint(p);
    fmt.println(moved.describe());   // Point(11, 11)

    // ---------- when 中使用对象 + 循环创建对象 ----------
    val kind = when {
        alice.age >= 18 -> "成年";
        else -> "未成年";
    };
    fmt.println(kind);               // 成年

    var total = 0;
    var i = 1;
    while (i <= 3) {
        val t = new CPoint(i, i);
        total += t.sum();
        i += 1;
    }
    fmt.println($"总和={total}");    // 12

    // internal 同包可见
    val ib = new CInternalBox();
    fmt.println(ib.secret);          // 7
    fmt.println(ib.peek());          // 7

    // v0.50：实例方法重载
    val ov = new COverload();
    fmt.println(ov.add(10));         // 11
    fmt.println(ov.add(10, 20));     // 30
}