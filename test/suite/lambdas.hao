// ============================================================
//  多文件测试套件 · lambdas：闭包 / 高阶函数 / 函数式集合
//  覆盖：lambda + hof
// ============================================================
package main;

// ---- 高阶函数：把函数当参数 ----
func lApply(f: (Int) -> Int, x: Int): Int {
    return f(x);
}

// ---- 返回一个函数（闭包捕获参数 n）----
func lMakeAdder(n: Int): (Int) -> Int {
    return { x: Int -> x + n };
}

// ---- 泛型高阶函数（map/filter/forEach/reduce 手写）----
func lMap<T, R>(arr: [T], f: (T) -> R): [R] {
    var out: [R] = [];
    var i = 0;
    while (i < arr.length) {
        out += f(arr[i]);
        i += 1;
    }
    return out;
}

func lFilter<T>(arr: [T], pred: (T) -> Bool): [T] {
    var out: [T] = [];
    var i = 0;
    while (i < arr.length) {
        if (pred(arr[i])) {
            out += arr[i];
        }
        i += 1;
    }
    return out;
}

func lForEach<T>(arr: [T], f: (T) -> Unit) {
    var i = 0;
    while (i < arr.length) {
        f(arr[i]);
        i += 1;
    }
}

func lReduce<T, R>(arr: [T], init: R, f: (R, T) -> R): R {
    var acc = init;
    var i = 0;
    while (i < arr.length) {
        acc = f(acc, arr[i]);
        i += 1;
    }
    return acc;
}

func lAdd(a: Int, b: Int): Int { return a + b; }

func lambdasTest() {
    // 1. 无捕获 lambda，显式参数类型
    val square: (Int) -> Int = { x: Int -> x * x };
    fmt.println(square(5));                       // 25

    // 2. 作为实参传给高阶函数，参数类型由形参推断（隐式 it）
    fmt.println(lApply({ it + 10 }, 32));          // 42

    // 3. 顶层函数当值传递（包装为闭包）
    val addFn: (Int, Int) -> Int = lAdd;
    fmt.println(addFn(20, 22));                   // 42

    // 4. 闭包捕获不可变值
    val base: Int = 100;
    val plusBase: (Int) -> Int = { x: Int -> x + base };
    fmt.println(plusBase(5));                     // 105

    // 5. 闭包捕获可变变量并修改（共享 cell）
    var counter: Int = 0;
    val tick: () -> Int = { counter = counter + 1; counter };
    fmt.println(tick());                          // 1
    fmt.println(tick());                          // 2
    fmt.println(counter);                         // 2

    // 6. 函数返回闭包
    val add3 = lMakeAdder(3);
    fmt.println(add3(40));                        // 43

    // 7. 无参 lambda + 末尾表达式隐式返回
    val greet: () -> String = { "你好，闭包" };
    fmt.println(greet());                         // 你好，闭包

    // 8. 手写泛型高阶函数
    var nums = [1, 2, 3, 4, 5];
    var doubled = lMap(nums, { x: Int -> x * 2 });
    fmt.println(doubled.length);       // 5
    fmt.println(doubled[0]);           // 2
    fmt.println(doubled[4]);           // 10

    var labels = lMap(nums, { $"n={it}" });
    fmt.println(labels.length);        // 5
    fmt.println(labels[2]);            // n=3

    var evens = lFilter(nums, { it % 2 == 0 });
    fmt.println(evens.length);         // 2
    fmt.println(evens[0]);             // 2
    fmt.println(evens[1]);             // 4

    var sum = 0;
    lForEach(nums, { sum = sum + it });
    fmt.println(sum);                  // 15

    var total = lReduce(nums, 0, lAdd);
    fmt.println(total);                // 15
    var product = lReduce(nums, 1, { acc, x -> acc * x });
    fmt.println(product);              // 120
}