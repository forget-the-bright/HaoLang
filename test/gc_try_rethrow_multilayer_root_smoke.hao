// U7b：再抛 / 多层 finally / for×break×finally GC 根（发现向；非全量 unwind）
package main;

import collections.*;
import exception.*;
import gc;

class Box {
    public var s: String = "";
    public constructor(s: String) { this.s = s; }
}

func main() {
    // 1) throw 穿 ≥3 层 finally
    var held = new Box("held");
    try {
        try {
            try {
                throw new Exception("deep");
            } finally {
                fmt.println(held.s == "held");
            }
        } finally {
            fmt.println(held.s == "held");
        }
    } catch (e: Exception) {
        fmt.println(held.s == "held");
    } finally {
        fmt.println(held.s == "held");
    }

    // 2) catch 后再 throw：外层 finally 根仍活
    var outer = new Box("outer");
    try {
        try {
            throw new Exception("inner");
        } catch (e: Exception) {
            fmt.println(outer.s == "outer");
            throw e;
        } finally {
            fmt.println(outer.s == "outer");
        }
    } catch (e2: Exception) {
        fmt.println(outer.s == "outer");
    } finally {
        fmt.println(outer.s == "outer");
    }

    // 3) for × break × finally（补 U4 continue / U6a while-break）
    var keep = new Box("keep");
    var xs = new List<Object>();
    xs.add(new Box("a"));
    xs.add(new Box("b"));
    xs.add(new Box("c"));
    var n = 0;
    for (it in xs) {
        try {
            n += 1;
            if (n == 2) {
                break;
            }
        } finally {
            fmt.println(keep.s == "keep");
        }
    }
    fmt.println(n == 2);
    fmt.println(keep.s == "keep");
    fmt.println(gc.GC.markAbortCycles() == 0);
}
