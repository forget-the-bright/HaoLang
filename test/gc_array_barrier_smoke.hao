// v0.53+：ptr 数组扩容在 MARK 下须 shade 拷贝元素（禁黑父白子）
package main;

import gc;
import collections.*;

func main() {
    var a = new ArrayList<Object>();
    var i = 0;
    while (i < 2048) {
        a.add(String.valueOf("x" + Integer.toStr(i)));
        i += 1;
    }
    // 丢掉唯一强引用；触发回收后堆不应因扩容漏标而崩，且应能完成 collect
    a = new ArrayList<Object>();
    gc.GC.collect();
    var j = 0;
    while (j < 512) {
        a.add(String.valueOf("y" + Integer.toStr(j)));
        j += 1;
    }
    a = new ArrayList<Object>();
    gc.GC.collect();
    fmt.println(gc.GC.collectCount() >= 2);
    fmt.println(gc.GC.stwMarkAllFallbacks() == 0);
    fmt.println(gc.GC.heapBytes() >= 0);
}
