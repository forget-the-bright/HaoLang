// v0.52：硬验收——密集分配后必须进入 MARK 并完成回收（单线程，避免协助 STW 互等）
package main;

import gc;
import collections.*;

func main() {
    var round = 0;
    while (round < 8) {
        var junk = new ArrayList<Object>();
        var i = 0;
        while (i < 4000) {
            junk.add(String.valueOf("r-" + Integer.toStr(i)));
            i += 1;
        }
        // 丢弃引用：短会话结束
        junk = new ArrayList<Object>();
        round += 1;
    }
    gc.GC.collect();

    fmt.println(gc.GC.concurrentMarkCycles() >= 1); // true
    fmt.println(gc.GC.collectCount() >= 1);         // true
    fmt.println(gc.GC.stwMarkAllFallbacks() == 0);  // true
    fmt.println(gc.GC.heapBytes() >= 0);            // true
}
