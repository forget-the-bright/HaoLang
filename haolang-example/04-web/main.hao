// MVC 演示：扫描 demo/web（含 api 子包），自测 JSON/模板/静态文件后退出。
// 若要常驻服务：把文末自测段换成 app.serve()，Ctrl+C 结束。
package main;

import demo.web;
import demo.web.api;
import net;
import os;
import thread;

func main() {
    val app = new net.HttpApp();
    val port = 18080;
    if (!app.listen(port)) {
        fmt.println($"listen fail on {port}");
        return;
    }
    val n = app.scan("demo/web");
    fmt.println($"routes registered ≈ {n} (expect >= 2)");

    // 静态文件：haolang-example/04-web/static
    val staticDir = "haolang-example/04-web/static";
    os.writeFile(os.Path.join(staticDir, "hello.txt"), "static-hello");
    app.staticFiles("/static", staticDir);

    fmt.println($"try: http://127.0.0.1:{port}/web/home");
app.serve(); 
    val th1 = new thread.Thread();
    th1.start({ app.serveOnce(); });
    thread.sleep(80);
    val r1 = net.Http.get($"http://127.0.0.1:{port}/web/home");
    fmt.println($"GET /web/home -> {r1.status} {r1.body}");
    th1.join();

    val th2 = new thread.Thread();
    th2.start({ app.serveOnce(); });
    thread.sleep(80);
    val r2 = net.Http.get($"http://127.0.0.1:{port}/web/api/v1");
    fmt.println($"GET /web/api/v1 -> {r2.body}");
    th2.join();

    val th3 = new thread.Thread();
    th3.start({ app.serveOnce(); });
    thread.sleep(80);
    val r3 = net.Http.post($"http://127.0.0.1:{port}/web/api/echo", "zz");
    fmt.println($"POST /web/api/echo -> {r3.body}");
    th3.join();

    val th4 = new thread.Thread();
    th4.start({ app.serveOnce(); });
    thread.sleep(80);
    val r4 = net.Http.get($"http://127.0.0.1:{port}/web/api/user");
    fmt.println($"GET /web/api/user -> {r4.body}");
    th4.join();

    val th5 = new thread.Thread();
    th5.start({ app.serveOnce(); });
    thread.sleep(80);
    val r5 = net.Http.get($"http://127.0.0.1:{port}/web/hi");
    fmt.println($"GET /web/hi -> {r5.body}");
    th5.join();

    val th6 = new thread.Thread();
    th6.start({ app.serveOnce(); });
    thread.sleep(80);
    val r6 = net.Http.get($"http://127.0.0.1:{port}/static/hello.txt");
    fmt.println($"GET /static/hello.txt -> {r6.body}");
    th6.join();

    app.close();
    fmt.println("web demo done");
}
