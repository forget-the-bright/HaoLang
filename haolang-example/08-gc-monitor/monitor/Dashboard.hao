// GC / 进程资源监控控制器（指标对齐 .NET Process + GC）
package monitor;

import gc;
import net.*;
import os;

// JSON 快照：字段供前端展示；中文含义见模板标签
class GcSnapshot {
    // ---- 进程内存（对标 .NET Process）----
    var workingSetBytes: Long = 0;   // 工作集：占用的物理内存
    var privateBytes: Long = 0;      // 专用内存：进程独占提交

    // ---- GC 托管堆（对标 GC 堆，非 OS 工作集）----
    var liveBytes: Long = 0;         // 上次成功 major 后存活（可能为 0）
    var heapBytes: Long = 0;         // 当前堆用户区合计（看堆压用这个）
    var nurseryBytes: Long = 0;      // 新生代已分配压力
    var threshold: Long = 0;
    var allocatedSinceGc: Long = 0;
    var blockCount: Long = 0;

    // ---- 回收次数（二分代：minor≈Gen0，major≈Gen2；无 Gen1）----
    var minorCount: Long = 0;        // ≈ Gen0
    var majorCount: Long = 0;        // ≈ Gen2
    var collectCount: Long = 0;
    var finalizerRuns: Long = 0;
    var finalizerSets: Long = 0;
    var stwIncomplete: Long = 0;     // STW 未齐次数（v0.53 终止未齐则 abort）
    var stwMarkAllFallbacks: Long = 0; // 已废除全标活，恒 0
    var concurrentMarkCycles: Long = 0; // 并发标记轮次
    var markAssistSteps: Long = 0;   // mark assist 推进量
    var markAbortCycles: Long = 0;   // 终止失败 abort MARK（v0.53.3）

    // ---- CPU / 线程 / 句柄 / 运行时长 ----
    var cpuPercent: Int = 0;         // 0～100；首次采样可能为 0
    var cpuReady: Bool = false;      // false=尚在采样
    var threadCount: Long = 0;       // OS 线程数
    var gcThreads: Long = 0;         // 已注册进 GC STW 的线程
    var handleCount: Long = 0;
    var uptimeMs: Long = 0;

    var usagePct: Int = 0;
    var summary: String = "";
    var note: String = "";
    var engine: String = "HaoLang GC v3（v0.53.3 入口 safepoint）+ os.Process";

    constructor() {
        this.refresh();
    }

    func refresh() {
        this.workingSetBytes = os.Process.workingSetBytes();
        this.privateBytes = os.Process.privateBytes();
        this.handleCount = os.Process.handleCount();
        this.threadCount = os.Process.threadCount();
        this.uptimeMs = os.Process.uptimeMs();
        val cpu = os.Process.cpuPercent();
        if (cpu < 0) {
            this.cpuReady = false;
            this.cpuPercent = 0;
        } else {
            this.cpuReady = true;
            this.cpuPercent = cpu;
        }

        // v0.53：一次持锁快照，避免十几次 gc_lock_coop
        val g = gc.GC.stats();
        this.liveBytes = g.liveBytes;
        this.heapBytes = g.heapBytes;
        this.nurseryBytes = g.nurseryBytes;
        this.threshold = g.threshold;
        this.allocatedSinceGc = g.allocatedSinceGc;
        this.blockCount = g.blockCount;
        this.minorCount = g.minorCount;
        this.majorCount = g.majorCount;
        this.collectCount = g.collectCount;
        this.finalizerRuns = g.finalizerRuns;
        this.finalizerSets = g.finalizerSets;
        this.stwIncomplete = g.stwIncomplete;
        this.stwMarkAllFallbacks = g.stwMarkAllFallbacks;
        this.concurrentMarkCycles = g.concurrentMarkCycles;
        this.markAssistSteps = g.markAssistSteps;
        this.markAbortCycles = g.markAbortCycles;
        this.gcThreads = g.registeredThreads;
        this.summary = $"GC[v3] live={this.liveBytes}B heap={this.heapBytes}B threshold={this.threshold}B"
            + $" allocatedSince={this.allocatedSinceGc}B blocks={this.blockCount}"
            + $" collects={this.collectCount} minor={this.minorCount} major={this.majorCount}"
            + $" stwIncomplete={this.stwIncomplete} concurrentMark={this.concurrentMarkCycles}"
            + $" markAssist={this.markAssistSteps} markAbort={this.markAbortCycles}";
        if (this.note.length == 0) {
            this.note = "对标说明：工作集/专用内存来自 os.Process；"
                + "heapBytes=当前堆压；liveBytes=上次成功 major 后存活；"
                + "v0.53.3：入口 safepoint + markAbortCycles；终止未齐则 abort MARK。";
        }
        var pct: Int = 0;
        if (this.threshold > 0) {
            val thr = this.threshold;
            val since = this.allocatedSinceGc;
            if (since >= thr) { pct = 100; }
            else { pct = Integer.parse(Long.toStr((since * 100) / thr)) ?? 0; }
        }
        this.usagePct = pct;
    }
}

class CollectResult {
    var ok: Bool = true;
    var message: String = "";
    var after: GcSnapshot?;
    constructor(msg: String, snap: GcSnapshot) {
        this.ok = true;
        this.message = msg;
        this.after = snap;
    }
}

@Controller
@RequestMapping(path = "/")
class DashboardController {
    @GetMapping(path = "/")
    func index(req: HttpRequest): HttpResponse {
        Html.setTemplateRoot("haolang-example/08-gc-monitor/templates");
        // 预热 CPU 采样（首次 -1）
        os.Process.cpuPercent();
        val snap = new GcSnapshot();
        val html = Html.renderFile("dashboard.html", snap);
        return HttpResponse.html(html);
    }

    @GetMapping(path = "/api/gc")
    func apiGc(req: HttpRequest): GcSnapshot {
        return new GcSnapshot();
    }

    @PostMapping(path = "/api/gc/collect")
    func apiCollect(req: HttpRequest): CollectResult {
        gc.GC.collect();
        val snap = new GcSnapshot();
        return new CollectResult("major collect done", snap);
    }
}
