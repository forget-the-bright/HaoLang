// GC / 进程资源监控控制器（v0.75.1：全量 /api/gc + 单次 stringify；计时以 X-Hao-* 为准）
package monitor;

import gc;
import json;
import net.*;
import os;
import time;

func monoNs(): Long {
    val t = time.now();
    return t.ts;
}

// 可选瘦响应：仅压测 /api/gc/lite（不得作默认）
class GcLatencyView {
    var heapBytes: Long = 0;
    var liveBytes: Long = 0;
    var freelistBytes: Long = 0;
    var spanCommitBytes: Long = 0;
    var privateBytes: Long = 0;
    var workingSetBytes: Long = 0;
    var collectCount: Long = 0;
    var stwIncomplete: Long = 0;
    var stwIncompleteRoot: Long = 0;
    var stwIncompleteTerm: Long = 0;
    var markAbortCycles: Long = 0;
    var stwWaitMsTotal: Long = 0;
    var lastCollectHoldMs: Long = 0;
    var lastUnlinkMs: Long = 0;
    var lastDrainMs: Long = 0;
    var lastStatsLockWaitMs: Long = 0;
    var lastStatsSafepointMs: Long = 0;
    var lastPublishMs: Long = 0;
    var statsPublishCount: Long = 0;
    var gcThreads: Long = 0;
    var scavengeBytes: Long = 0;
    var spanCount: Long = 0;
    var procMs: Long = 0;
    var gcStatsMs: Long = 0;
    var handlerMs: Long = 0;
    var jsonMs: Long = 0;
    var serverTotalMs: Long = 0;
    var summary: String = "";
    var engine: String = "HaoLang GC v0.75.1 HTTP-LAT";
}

// 全量快照：面板 + 默认 GET /api/gc
class GcSnapshot {
    var workingSetBytes: Long = 0;
    var privateBytes: Long = 0;
    var liveBytes: Long = 0;
    var heapBytes: Long = 0;
    var nurseryBytes: Long = 0;
    var threshold: Long = 0;
    var allocatedSinceGc: Long = 0;
    var blockCount: Long = 0;
    var minorCount: Long = 0;
    var majorCount: Long = 0;
    var collectCount: Long = 0;
    var finalizerRuns: Long = 0;
    var finalizerSets: Long = 0;
    var stwIncomplete: Long = 0;
    var stwMarkAllFallbacks: Long = 0;
    var concurrentMarkCycles: Long = 0;
    var markAssistSteps: Long = 0;
    var markAbortCycles: Long = 0;
    var markWorkerSteps: Long = 0;
    var remsetCount: Long = 0;
    var parkWatchdogTrips: Long = 0;
    var stwIncompleteRoot: Long = 0;
    var stwIncompleteTerm: Long = 0;
    var markAbortRoot: Long = 0;
    var markAbortTerm: Long = 0;
    var markAbortParkWd: Long = 0;
    var lastStwPhase: Long = 0;
    var lastStwAttempt: Long = 0;
    var lastStwTargets: Long = 0;
    var lastStwParked: Long = 0;
    var lastStwMissing: Long = 0;
    var lastStwOsBlockMissing: Long = 0;
    var lastMissTidCount: Long = 0;
    var lastMissTid0: Long = 0;
    var lastMissTid1: Long = 0;
    var lastMissMaxAgeMs: Long = -1;
    var finalizerSkipAbort: Long = 0;
    var finalizerLiveAtSweep: Long = 0;
    var lastFinalizerDiag: Long = 0;
    var concurrentSweepCycles: Long = 0;
    var spanSweepChunks: Long = 0;
    var freelistHits: Long = 0;
    var stwWaitMsTotal: Long = 0;
    var spanCommitBytes: Long = 0;
    var freelistBytes: Long = 0;
    var scavengeBytes: Long = 0;
    var scavengeCycles: Long = 0;
    var spanCount: Long = 0;
    var lastCollectHoldMs: Long = 0;
    var lastUnlinkMs: Long = 0;
    var lastDrainMs: Long = 0;
    var lastScavengeMs: Long = 0;
    var lastStatsLockWaitMs: Long = 0;
    var lastPublishMs: Long = 0;
    var statsPublishCount: Long = 0;
    var lastStatsSafepointMs: Long = 0;
    var cpuPercent: Int = 0;
    var cpuReady: Bool = false;
    var threadCount: Long = 0;
    var gcThreads: Long = 0;
    var handleCount: Long = 0;
    var uptimeMs: Long = 0;
    var usagePct: Int = 0;
    var summary: String = "";
    var note: String = "";
    var engine: String = "HaoLang GC v0.75.1 HTTP-LAT";
    var procMs: Long = 0;
    var gcStatsMs: Long = 0;
    var handlerMs: Long = 0;
    var jsonMs: Long = 0;
    var serverTotalMs: Long = 0;

    static var procCacheMs: Long = 0;
    static var cachedWs: Long = 0;
    static var cachedPrivate: Long = 0;
    static var cachedHandles: Long = 0;
    static var cachedThreads: Long = 0;
    static var cachedUptime: Long = 0;
    static var cachedCpu: Int = 0;
    static var cachedCpuReady: Bool = false;
    static var threadCacheMs: Long = 0;

    constructor() {
        this.note = "v0.75.1：/api/gc 全量 GcSnapshot；jsonMs/serverTotal 以 X-Hao-* 头为准；lite 见 /api/gc/lite。";
    }

    static func nsToMs(deltaNs: Long): Long {
        if (deltaNs <= 0) return 0;
        return deltaNs / 1000000;
    }

    // lean=true：不调 threadCount（禁 Toolhelp）；WS/private 250ms 缓存
    func refreshProcLean() {
        val t0 = monoNs();
        val now = os.Process.uptimeMs();
        val age = now - GcSnapshot.procCacheMs;
        if (GcSnapshot.procCacheMs != 0 && age >= 0 && age < 250) {
            this.workingSetBytes = GcSnapshot.cachedWs;
            this.privateBytes = GcSnapshot.cachedPrivate;
            this.handleCount = GcSnapshot.cachedHandles;
            this.uptimeMs = GcSnapshot.cachedUptime;
            this.cpuPercent = GcSnapshot.cachedCpu;
            this.cpuReady = GcSnapshot.cachedCpuReady;
            this.threadCount = GcSnapshot.cachedThreads;
            this.procMs = GcSnapshot.nsToMs(monoNs() - t0);
            return;
        }
        this.workingSetBytes = os.Process.workingSetBytes();
        this.privateBytes = os.Process.privateBytes();
        this.handleCount = os.Process.handleCount();
        this.uptimeMs = os.Process.uptimeMs();
        val cpu = os.Process.cpuPercent();
        if (cpu < 0) {
            this.cpuReady = false;
            this.cpuPercent = 0;
        } else {
            this.cpuReady = true;
            this.cpuPercent = cpu;
        }
        // 线程数：≥2s 才刷 Toolhelp；热路径复用缓存（可 0）
        val tage = now - GcSnapshot.threadCacheMs;
        if (GcSnapshot.threadCacheMs == 0 || tage < 0 || tage >= 2000) {
            this.threadCount = os.Process.threadCount();
            GcSnapshot.threadCacheMs = now;
            GcSnapshot.cachedThreads = this.threadCount;
        } else {
            this.threadCount = GcSnapshot.cachedThreads;
        }
        GcSnapshot.procCacheMs = this.uptimeMs;
        GcSnapshot.cachedWs = this.workingSetBytes;
        GcSnapshot.cachedPrivate = this.privateBytes;
        GcSnapshot.cachedHandles = this.handleCount;
        GcSnapshot.cachedUptime = this.uptimeMs;
        GcSnapshot.cachedCpu = this.cpuPercent;
        GcSnapshot.cachedCpuReady = this.cpuReady;
        this.procMs = GcSnapshot.nsToMs(monoNs() - t0);
    }

    func applyGcStats(g: gc.GcStats) {
        this.liveBytes = g.liveBytes;
        this.heapBytes = g.heapBytes;
        this.nurseryBytes = g.nurseryBytes;
        this.threshold = g.threshold;
        this.allocatedSinceGc = g.allocatedSinceGc;
        this.blockCount = g.blockCount;
        this.minorCount = g.minorCount;
        this.majorCount = g.majorCount;
        this.collectCount = g.collectCount;
        this.finalizerRuns = g.finalizerRuns;
        this.finalizerSets = g.finalizerSets;
        this.stwIncomplete = g.stwIncomplete;
        this.stwMarkAllFallbacks = g.stwMarkAllFallbacks;
        this.concurrentMarkCycles = g.concurrentMarkCycles;
        this.markAssistSteps = g.markAssistSteps;
        this.markAbortCycles = g.markAbortCycles;
        this.markWorkerSteps = g.markWorkerSteps;
        this.remsetCount = g.remsetCount;
        this.parkWatchdogTrips = g.parkWatchdogTrips;
        this.stwIncompleteRoot = g.stwIncompleteRoot;
        this.stwIncompleteTerm = g.stwIncompleteTerm;
        this.markAbortRoot = g.markAbortRoot;
        this.markAbortTerm = g.markAbortTerm;
        this.markAbortParkWd = g.markAbortParkWd;
        this.lastStwPhase = g.lastStwPhase;
        this.lastStwAttempt = g.lastStwAttempt;
        this.lastStwTargets = g.lastStwTargets;
        this.lastStwParked = g.lastStwParked;
        this.lastStwMissing = g.lastStwMissing;
        this.lastStwOsBlockMissing = g.lastStwOsBlockMissing;
        this.lastMissTidCount = g.lastMissTidCount;
        this.lastMissTid0 = g.lastMissTid0;
        this.lastMissTid1 = g.lastMissTid1;
        this.lastMissMaxAgeMs = g.lastMissMaxAgeMs;
        this.finalizerSkipAbort = g.finalizerSkipAbort;
        this.finalizerLiveAtSweep = g.finalizerLiveAtSweep;
        this.lastFinalizerDiag = g.lastFinalizerDiag;
        this.concurrentSweepCycles = g.concurrentSweepCycles;
        this.spanSweepChunks = g.spanSweepChunks;
        this.freelistHits = g.freelistHits;
        this.stwWaitMsTotal = g.stwWaitMsTotal;
        this.spanCommitBytes = g.spanCommitBytes;
        this.freelistBytes = g.freelistBytes;
        this.scavengeBytes = g.scavengeBytes;
        this.scavengeCycles = g.scavengeCycles;
        this.spanCount = g.spanCount;
        this.lastCollectHoldMs = g.lastCollectHoldMs;
        this.lastUnlinkMs = g.lastUnlinkMs;
        this.lastDrainMs = g.lastDrainMs;
        this.lastScavengeMs = g.lastScavengeMs;
        this.lastStatsLockWaitMs = g.lastStatsLockWaitMs;
        this.lastPublishMs = g.lastPublishMs;
        this.statsPublishCount = g.statsPublishCount;
        this.lastStatsSafepointMs = g.lastStatsSafepointMs;
        this.gcThreads = g.registeredThreads;
        this.summary = $"heap={this.heapBytes} hold={this.lastCollectHoldMs}"
            + $" sp={this.lastStatsSafepointMs} collect={this.collectCount}";
        var pct: Int = 0;
        if (this.threshold > 0) {
            val thr = this.threshold;
            val since = this.allocatedSinceGc;
            if (since >= thr) { pct = 100; }
            else { pct = Integer.parse(Long.toStr((since * 100) / thr)) ?? 0; }
        }
        this.usagePct = pct;
    }

    func refreshFull(withProc: Bool) {
        val tAll = monoNs();
        if (withProc) {
            this.refreshProcLean();
        }
        val tGc = monoNs();
        val g = gc.GC.stats();
        this.gcStatsMs = GcSnapshot.nsToMs(monoNs() - tGc);
        this.applyGcStats(g);
        this.handlerMs = GcSnapshot.nsToMs(monoNs() - tAll);
    }

    func toLatencyView(): GcLatencyView {
        val v = new GcLatencyView();
        v.heapBytes = this.heapBytes;
        v.liveBytes = this.liveBytes;
        v.freelistBytes = this.freelistBytes;
        v.spanCommitBytes = this.spanCommitBytes;
        v.privateBytes = this.privateBytes;
        v.workingSetBytes = this.workingSetBytes;
        v.collectCount = this.collectCount;
        v.stwIncomplete = this.stwIncomplete;
        v.stwIncompleteRoot = this.stwIncompleteRoot;
        v.stwIncompleteTerm = this.stwIncompleteTerm;
        v.markAbortCycles = this.markAbortCycles;
        v.stwWaitMsTotal = this.stwWaitMsTotal;
        v.lastCollectHoldMs = this.lastCollectHoldMs;
        v.lastUnlinkMs = this.lastUnlinkMs;
        v.lastDrainMs = this.lastDrainMs;
        v.lastStatsLockWaitMs = this.lastStatsLockWaitMs;
        v.lastStatsSafepointMs = this.lastStatsSafepointMs;
        v.lastPublishMs = this.lastPublishMs;
        v.statsPublishCount = this.statsPublishCount;
        v.gcThreads = this.gcThreads;
        v.scavengeBytes = this.scavengeBytes;
        v.spanCount = this.spanCount;
        v.procMs = this.procMs;
        v.gcStatsMs = this.gcStatsMs;
        v.handlerMs = this.handlerMs;
        v.jsonMs = this.jsonMs;
        v.serverTotalMs = this.serverTotalMs;
        v.summary = $"srv={this.serverTotalMs} gc={this.gcStatsMs} json={this.jsonMs}"
            + $" proc={this.procMs} hold={this.lastCollectHoldMs} sp={this.lastStatsSafepointMs}";
        return v;
    }
}

class ProcSnapshot {
    var workingSetBytes: Long = 0;
    var privateBytes: Long = 0;
    var handleCount: Long = 0;
    var threadCount: Long = 0;
    var uptimeMs: Long = 0;
    var cpuPercent: Int = 0;
    var cpuReady: Bool = false;
    var procMs: Long = 0;
}

class CollectResult {
    var ok: Bool = true;
    var message: String = "";
    var after: GcSnapshot?;
    constructor(msg: String, snap: GcSnapshot) {
        this.ok = true;
        this.message = msg;
        this.after = snap;
    }
}

@Controller
@RequestMapping(path = "/")
class DashboardController {
    @GetMapping(path = "/")
    func index(req: HttpRequest): HttpResponse {
        Html.setTemplateRoot("haolang-example/08-gc-monitor/templates");
        os.Process.cpuPercent();
        val snap = new GcSnapshot();
        snap.refreshFull(true);
        val html = Html.renderFile("dashboard.html", snap);
        return HttpResponse.html(html);
    }

    // 全量 GcSnapshot；反射 BeanInfo+索引读；单次 stringify；计时权威 X-Hao-*
    @GetMapping(path = "/api/gc")
    func apiGc(req: HttpRequest): HttpResponse {
        val t0 = monoNs();
        val snap = new GcSnapshot();
        snap.refreshFull(true);
        snap.jsonMs = 0;
        snap.serverTotalMs = 0;
        snap.summary = $"gc={snap.gcStatsMs} proc={snap.procMs} hold={snap.lastCollectHoldMs}"
            + $" sp={snap.lastStatsSafepointMs} collect={snap.collectCount}";
        val tJson = monoNs();
        val body = json.JSON.toJSONString(snap);
        val jsonMs = GcSnapshot.nsToMs(monoNs() - tJson);
        val serverMs = GcSnapshot.nsToMs(monoNs() - t0);
        val r = HttpResponse.json(200, body);
        r.headers = "X-Hao-Server-Ms: " + Long.toStr(serverMs) + "\r\n"
            + "X-Hao-GcStats-Ms: " + Long.toStr(snap.gcStatsMs) + "\r\n"
            + "X-Hao-Json-Ms: " + Long.toStr(jsonMs) + "\r\n"
            + "X-Hao-Proc-Ms: " + Long.toStr(snap.procMs) + "\r\n";
        return r;
    }

    // 可选瘦路径（压测）；默认面板勿依赖
    @GetMapping(path = "/api/gc/lite")
    func apiGcLite(req: HttpRequest): HttpResponse {
        val t0 = monoNs();
        val full = new GcSnapshot();
        full.refreshFull(true);
        val view = full.toLatencyView();
        view.jsonMs = 0;
        view.serverTotalMs = 0;
        view.summary = $"gc={view.gcStatsMs} proc={view.procMs} hold={view.lastCollectHoldMs}"
            + $" sp={view.lastStatsSafepointMs}";
        val tJson = monoNs();
        val body = json.JSON.toJSONString(view);
        val jsonMs = GcSnapshot.nsToMs(monoNs() - tJson);
        val serverMs = GcSnapshot.nsToMs(monoNs() - t0);
        val r = HttpResponse.json(200, body);
        r.headers = "X-Hao-Server-Ms: " + Long.toStr(serverMs) + "\r\n"
            + "X-Hao-Json-Ms: " + Long.toStr(jsonMs) + "\r\n";
        return r;
    }

    @GetMapping(path = "/api/proc")
    func apiProc(req: HttpRequest): ProcSnapshot {
        val t0 = monoNs();
        val p = new ProcSnapshot();
        p.workingSetBytes = os.Process.workingSetBytes();
        p.privateBytes = os.Process.privateBytes();
        p.handleCount = os.Process.handleCount();
        p.threadCount = os.Process.threadCount();
        p.uptimeMs = os.Process.uptimeMs();
        val cpu = os.Process.cpuPercent();
        if (cpu < 0) {
            p.cpuReady = false;
            p.cpuPercent = 0;
        } else {
            p.cpuReady = true;
            p.cpuPercent = cpu;
        }
        p.procMs = GcSnapshot.nsToMs(monoNs() - t0);
        return p;
    }

    @PostMapping(path = "/api/gc/collect")
    func apiCollect(req: HttpRequest): CollectResult {
        gc.GC.collect();
        val full = new GcSnapshot();
        full.refreshFull(true);
        return new CollectResult("major collect done", full);
    }
}
