// GC / 内存监控 Web：浏览器打开后每 5 秒刷新。
// 仓库根执行：hao run haolang-example\08-gc-monitor\main.hao
package main;

import monitor;
import net;
import collections.*;
import thread.*;
import gc;
import time;
import os;

func main() {
    val app = new net.HttpApp();
    val port = 18090;
    if (!app.listen(port)) {
        fmt.println($"listen fail on {port}");
        return;
    }
    val n = app.scan("monitor");
    fmt.println($"GC Monitor routes ≈ {n}");
    fmt.println($"open: http://127.0.0.1:{port}/");
    fmt.println("API: GET /api/gc (full) | GET /api/gc/lite | POST /api/gc/collect");
    fmt.println("Ctrl+C 结束");

    // v0.72：默认稀预热，不靠打满 nursery 折磨 /api/gc。
    // 压测 STW：HAO_GC_MONITOR_WARM_BATCH=4000 HAO_GC_MONITOR_WARM_PAUSE_MS=500
    // 禁止把 batch 改回 40 当「修好」。
    var warmBatch = 1000;
    var warmPause = 1500;
    val batchEnv = os.getenv("HAO_GC_MONITOR_WARM_BATCH");
    if (batchEnv != null) {
        val p = Integer.parse(batchEnv!!);
        // 允许 0：latency 门禁关预热，避免造压污染墙钟
        if (p != null && p!! >= 0) { warmBatch = p!!; }
    }
    val pauseEnv = os.getenv("HAO_GC_MONITOR_WARM_PAUSE_MS");
    if (pauseEnv != null) {
        val p = Integer.parse(pauseEnv!!);
        if (p != null && p!! > 0) { warmPause = p!!; }
    }
    fmt.println($"warmup batch={warmBatch} pauseMs={warmPause} (env override ok)");

    val th1 = new Thread();
    th1.start({
        while (false) {
            var timeBegin = time.now();
            if (warmBatch > 0) {
                var junk = new ArrayList<Object>();
                var i = 0;
                while (i < warmBatch) {
                    junk.add(String.valueOf("warm-" + Integer.toStr(i)));
                    i = i + 1;
                }
            }
            var pause = warmPause;
            val abort = gc.GC.markAbortCycles();
            val inc = gc.GC.stwIncomplete();
            if (abort > 32 || inc > 64) { pause = warmPause * 4; }
            if (abort > 128 || inc > 256) { pause = warmPause * 10; }
            sleep(pause);
            var timeEnd = time.now();
            fmt.println($"执行完一次循环造垃圾数据_pause:{pause}: 开始时间-{timeBegin.format("yyyy-MM-dd HH:mm:ss")}-结束时间-{timeEnd.format("yyyy-MM-dd HH:mm:ss")}");
        }
    });

    // boss 只 accept，worker 处理连接（避免与 STW 叠加抢 accept）
    app.serveBossWorkers(4);
    /* 正常永不返回；若回到这里或进程直接消失，查 stderr / 仓库根 hao-crash.log */
    fmt.println("错误：serveBossWorkers 已返回（服务循环不应结束）");
}
