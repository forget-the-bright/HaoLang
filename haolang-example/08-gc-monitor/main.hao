// GC / 内存监控 Web：浏览器打开后每 5 秒刷新。
// 仓库根执行：hao run haolang-example\08-gc-monitor\main.hao
package main;

import monitor;
import net;
import collections.*;
import thread.*;

func main() {
    val app = new net.HttpApp();
    val port = 18090;
    if (!app.listen(port)) {
        fmt.println($"listen fail on {port}");
        return;
    }
    val n = app.scan("monitor");
    fmt.println($"GC Monitor routes ≈ {n}");
    fmt.println($"open: http://127.0.0.1:{port}/");
    fmt.println("API: GET /api/gc  |  POST /api/gc/collect");
    fmt.println("Ctrl+C 结束");

    // v0.50.4 验收：4000 次保活分配会反复打满 nursery → 协作 STW；
    // 不得再靠把循环改回 40「假装修好」。/api/gc 应仍可在秒级响应。
    val th1 = new Thread();
    th1.start({
        while (true) {
            var junk = new List<Object>();
            var i = 0;
            while (i < 4000) {
                junk.add(String.valueOf("warm-" + Integer.toStr(i)));
                i += 1;
            }
            sleep(500);
        }
    });

    // boss 只 accept，worker 处理连接（避免与 STW 叠加抢 accept）
    app.serveBossWorkers(4);
}
